---
/**
 * Shell.astro — the only page layout. Chrome and type come from site.css.
 */
import '../styles/site.css';
import Mast from '../components/Mast.astro';
import Colophon from '../components/Colophon.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
}
const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-nodes.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Mast active={active} />
    <slot />
    <Colophon active={active} />
    <script>
      import { initInlineSearch } from '../islands/search-inline';
      document.querySelectorAll('[data-inline-search]').forEach((el) => initInlineSearch(el as HTMLElement));
    </script>
  </body>
</html>
