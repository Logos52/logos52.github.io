---
import '../styles/ndc/fonts.css';
import '../styles/ndc/part-01.css';
import '../styles/ndc/part-02.css';
import '../styles/ndc/part-03.css';
import '../styles/ndc/part-04.css';
import '../styles/ndc/part-05.css';
import '../styles/ndc/part-06.css';
import '../styles/ndc/part-07.css';
import '../styles/ndc/part-08.css';
import '../styles/ndc/part-09.css';
import '../styles/ndc/extras.css';

type Props = {
  title: string;
  description?: string;
  kind?: string;
  section?: string;
};

const { title, description, kind = 'home', section = '' } = Astro.props;
const links = [
  { id: 'explainers', href: '/explainers/', label: 'Explainers' },
  { id: 'projects', href: '/projects/', label: 'Projects' },
  { id: 'journal', href: '/journal/', label: 'Journal' },
  { id: 'about', href: '/about/', label: 'About' },
];
const here =
  section === 'explainers'
    ? 'Explainers'
    : section === 'projects'
      ? 'Projects'
      : section === 'journal'
        ? 'Journal'
        : section === 'about'
          ? 'About'
          : 'Home';
---

<!doctype html>
<html lang="en" data-page={kind}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var p = 'auto';
        try {
          p = localStorage.getItem('logos52-theme') || 'auto';
        } catch (e) {}
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function apply() {
          var r = p === 'auto' ? (mq.matches ? 'dark' : 'light') : p;
          document.documentElement.setAttribute('data-theme', r);
          document.querySelectorAll('[data-theme-set]').forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute('data-theme-set') === r));
          });
        }
        apply();
        mq.addEventListener && mq.addEventListener('change', apply);
        document.addEventListener('DOMContentLoaded', function () {
          apply();
          document.querySelectorAll('[data-theme-set]').forEach(function (b) {
            b.addEventListener('click', function () {
              p = b.getAttribute('data-theme-set');
              try {
                localStorage.setItem('logos52-theme', p);
              } catch (e) {}
              apply();
            });
          });
        });
      })();
    </script>
  </head>
  <body>
    <header class="ia-bar">
      <div class="ia-bar-inner">
        <nav class="crumb" aria-label="Breadcrumb">
          <a class="brand" href="/">
            <svg class="mark-bar" xmlns="http://www.w3.org/2000/svg" viewBox="4 6 40 40" aria-hidden="true">
              <path d="M24 25 L11 25 M24 25 L31 38" stroke="#1a1a1a" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="24" cy="25" r="6.5" fill="#1a1a1a"></circle>
              <circle cx="11" cy="25" r="4" fill="#1a1a1a"></circle>
              <circle cx="31" cy="38" r="4" fill="#1a1a1a"></circle>
              <circle cx="38" cy="13" r="3.5" fill="#1a1a1a"></circle>
            </svg>
            Logos52
          </a>
          <span class="slash">/</span>
          <span class="here">{here}</span>
        </nav>
        <div class="bar-right">
          <nav class="meta-links" aria-label="Site">
            {
              links.map((link) => (
                <a href={link.href} class={section === link.id ? 'current' : undefined}>
                  {link.label}
                </a>
              ))
            }
          </nav>
          <label class="bar-search">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 L14 14"></path></svg>
            <input type="search" id="site-search" placeholder="Search" aria-label="Search this page" autocomplete="off" />
            <kbd>/</kbd>
          </label>
          <details class="menu">
            <summary aria-label="Menu">
              <svg viewBox="0 0 22 22" aria-hidden="true"><path d="M3.5 6.5h15M3.5 11h15M3.5 15.5h15"></path></svg>
            </summary>
            <nav aria-label="Menu">
              <a href="/" class={section === 'home' ? 'current' : undefined}>Home</a>
              {
                links.map((link) => (
                  <a href={link.href} class={section === link.id ? 'current' : undefined}>
                    {link.label}
                  </a>
                ))
              }
              <div class="menu-set">
                <div class="seg" role="group" aria-label="Appearance">
                  <button type="button" data-theme-set="light" aria-label="Light" title="Light">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3"></circle><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4"></path></svg>
                  </button>
                  <button type="button" data-theme-set="dark" aria-label="Dark" title="Dark">
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 9.5 A5.5 5.5 0 1 1 6.5 3 A4.3 4.3 0 0 0 13 9.5 Z"></path></svg>
                  </button>
                </div>
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <slot />
    <script>
      import '../scripts/ndc-ui';
    </script>
  </body>
</html>
