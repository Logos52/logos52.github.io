---
/**
 * Base.astro — the document shell for the KB Astro site.
 *
 * Owns:
 *  - <html lang="en" data-accent="violet"> (KB look) — dark mode via [data-theme="dark"].
 *  - The DS CSS imports, ONCE (styles.css = font + token manifest; domains.css = --d-* hues).
 *  - A no-flash inline script that sets data-theme from localStorage('theme') or
 *    prefers-color-scheme BEFORE first paint.
 *  - <Chrome/> + <slot/> + <Footer/>.
 *  - A small client script wiring #theme-toggle to flip [data-theme] + persist localStorage.
 *
 * No other component re-imports global CSS (ground rule).
 */
import '../styles/ds/styles.css';
import '../styles/ds/domains.css';
import '../styles/ds/flavors-preview.css'; // TEMP: cool-neutral palette preview (?palette=slate|overcast|charcoal)
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
import Chrome from '../components/Chrome.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Active nav id passed through to Chrome (atlas | notes | projects | about). */
  active?: string;
}
const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en" data-accent="violet" data-palette="slate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-nodes.svg" type="image/svg+xml" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {/* No-flash theme: resolve before paint, set data-theme on <html>. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia &&
                  window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    {/* TEMP palette preview: ?palette=slate|overcast|charcoal (persists), default slate. */}
    <script is:inline>
      (function () {
        try {
          var valid = { slate: 1, overcast: 1, charcoal: 1 };
          var p = new URLSearchParams(location.search).get('palette');
          if (!valid[p]) p = localStorage.getItem('palette');
          if (!valid[p]) p = 'slate';
          document.documentElement.setAttribute('data-palette', p);
          try { localStorage.setItem('palette', p); } catch (e) {}
        } catch (e) {
          document.documentElement.setAttribute('data-palette', 'slate');
        }
      })();
    </script>
  </head>
  <body>
    <Chrome active={active} />
    <slot />
    <Footer />

    {/* Theme toggle: flip [data-theme] on <html>, persist to localStorage('theme'). */}
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var html = document.documentElement;
          var next =
            html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
        });
      })();
    </script>

    {/* Inline dropdown search — chrome bar only; no modal overlay. */}
    <script>
      import { initInlineSearch } from '../islands/search-inline';
      document
        .querySelectorAll('[data-inline-search]')
        .forEach((el) => initInlineSearch(el as HTMLElement));
    </script>
  </body>
</html>

<style is:global>
  html {
    /* Paper & Ink base surface — tokens own the actual values. */
    --kb-content: 880px; /* global content width → uniform side whitespace across every page */
    background: var(--paper);
    color: var(--ink);
  }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  /* The <slot/> content (main) takes the remaining height so the footer sinks. */
  body > :global(main) {
    flex: 1;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* inline search dropdown — shared; rows are injected by src/islands/search-inline.ts */
  [data-search-results] {
    position: absolute;
    z-index: 40;
    margin-top: 6px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--tsg-radius-sm);
    box-shadow: var(--tsg-shadow-md, var(--tsg-shadow));
    padding: 6px;
    max-height: 62vh;
    overflow-y: auto;
  }
  [data-search-results][hidden] {
    display: none;
  }
  .kb-ac-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 10px;
    align-items: baseline;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .kb-ac-row.on,
  .kb-ac-row:hover {
    background: var(--accent-soft);
  }
  .kb-ac-title {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
  }
  .kb-ac-domain {
    font-family: var(--mono);
    font-size: var(--kb-text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .kb-ac-ex {
    grid-column: 1 / -1;
    font-size: var(--kb-text-xs);
    color: var(--mut);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kb-ac-empty {
    padding: 12px;
    color: var(--faint);
    font-size: var(--kb-text-sm);
    margin: 0;
  }
</style>
