---
import Base from './Base.astro';
import { slugToUrl } from '../lib/slug';
import type { Backlink } from '../lib/types';

type Props = {
  title: string;
  type?: string;
  description?: string;
  updated?: string;
  slug: string;
  backlinks: Backlink[];
};

const { title, type, description, updated, slug, backlinks } = Astro.props;
const parts = slug.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);
const folder = parts.length > 1 ? parts[parts.length - 2].replace(/--and--/g, ' & ').replace(/-/g, ' ') : '';
const kind = [type, folder].filter(Boolean).join(' · ');
const section = parts[0] === 'journal' ? 'journal' : parts[0] === 'projects' ? 'projects' : parts[0] === 'wiki' ? 'explainers' : '';
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
let updatedLabel = '';
if (updated && /^\d{4}-\d{2}-\d{2}/.test(updated)) {
  const [y, m, d] = updated.slice(0, 10).split('-').map(Number);
  updatedLabel = `${d} ${months[m - 1]} ${y}`;
} else if (updated) {
  updatedLabel = updated;
}
const shown = backlinks.slice(0, 8);
const more = backlinks.slice(8);
---

<Base title={`${title} — Logos52`} description={description} kind="article" section={section}>
  <div class="page" id="page-article">
    <div class="top-block">
      <div class="intro-col">
        <header class="mast"><span class="title">{title}</span></header>
        {description && <p class="abstract">{description}</p>}
        <div class="essay-body" data-pagefind-body data-pagefind-meta={`title:${title}`}>
          <slot />
          {
            shown.length > 0 && (
              <>
                <h2>Linked from</h2>
                <div class="lf">
                  {shown.map((link) => (
                    <a href={slugToUrl(link.slug)}>
                      {link.title}
                      {link.context && <span>{link.context}</span>}
                    </a>
                  ))}
                </div>
                {
                  more.length > 0 && (
                    <details>
                      <summary class="more">{more.length} more</summary>
                      <div class="lf">
                        {more.map((link) => (
                          <a href={slugToUrl(link.slug)}>
                            {link.title}
                            {link.context && <span>{link.context}</span>}
                          </a>
                        ))}
                      </div>
                    </details>
                  )
                }
              </>
            )
          }
        </div>
      </div>
      <aside class="org" aria-label="About this page">
        <div id="article-facts">
          {kind && (
            <>
              <h6>Kind</h6>
              <p>{kind}</p>
            </>
          )}
          {updatedLabel && (
            <>
              <h6>Updated</h6>
              <p>{updatedLabel}</p>
            </>
          )}
        </div>
      </aside>
    </div>
  </div>
  <dialog class="lightbox" aria-label="Full-size image">
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <img alt="" />
  </dialog>
</Base>
