---
/**
 * Toc.astro — sticky aside table of contents, h2 only (2026-10-15: h3 dropped, no static
 * current-item highlight since nothing follows the scroll).
 * No visible section label — the list of anchors is self-explanatory; a heading
 * that restates "on this page" is pure redundancy.
 */
interface Heading {
  depth: number;
  text: string;
  slug: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <nav class="kb-toc" aria-label="Contents">
      <ul class="kb-toc-list">
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="kb-toc-link">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .kb-toc-list {
    list-style: none;
    margin: 0;
    padding: 0 0 0 14px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    border-left: 1px solid var(--rule);
  }
  .kb-toc-link {
    font-size: 12.5px;
    color: var(--mut);
    text-decoration: none;
    transition: color 0.12s ease;
  }
  .kb-toc-link:hover {
    color: var(--ink);
  }
</style>
