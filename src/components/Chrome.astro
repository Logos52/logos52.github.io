---
/**
 * Chrome.astro — sticky top bar. Ported pixel-for-pixel from the DS KB
 * screens.jsx <Chrome> (sticky header variant) + styles.html .chrome.
 *
 * Brand lockup (mark-nodes-violet + "Knowledge base" + "second brain" kicker),
 * nav with .on active state, theme-toggle button (#theme-toggle, wired by Base),
 * and one inline search field (dropdown results, no modal). On phones (≤720px) the field is
 * replaced by a round magnifier button that opens the same field full-width under the header row.
 */
interface Props {
  /** Active nav id — one of "map" | "notes" | "projects" | "journal" | "personal" | "about". */
  active?: string;
}
const { active } = Astro.props;

const nav: { id: string; label: string; href: string }[] = [
  { id: 'map', label: 'Map', href: '/map' },
  { id: 'notes', label: 'Notes', href: '/notes' },
  { id: 'projects', label: 'Projects', href: '/projects' },
  { id: 'journal', label: 'Journal', href: '/journal' },
  { id: 'personal', label: 'Personal', href: '/personal' },
  { id: 'about', label: 'About', href: '/about' },
];
---

<header class="kb-chrome">
  <div class="kb-chrome__inner">
    <a class="kb-brand" href="/">
      <svg class="kb-brand__mark" viewBox="0 0 104 104" width="30" height="30" role="img" aria-label="Logos52" fill="none">
        <g stroke="currentColor" stroke-width="5" stroke-linecap="round">
          <path d="M52 52 L28 52 M52 52 L66 80" />
        </g>
        <g fill="currentColor">
          <circle cx="28" cy="52" r="8" />
          <circle cx="66" cy="80" r="8" />
          <circle cx="80" cy="32" r="7" />
          <circle cx="52" cy="52" r="12" />
        </g>
      </svg>
      <span class="kb-brand__name">Logos52</span>
    </a>
    <nav class="kb-nav">
      {nav.map((n) => (
        <a href={n.href} class:list={['kb-nav__link', { on: active === n.id }]}>
          {n.label}
        </a>
      ))}
    </nav>
    <span class="kb-spacer"></span>
    <button
      type="button"
      id="theme-toggle"
      class="kb-theme-toggle"
      title="Toggle theme"
      aria-label="Toggle theme"
    >
      <span class="kb-theme-toggle__light">☾</span>
      <span class="kb-theme-toggle__dark">☀</span>
    </button>
    <button
      type="button"
      class="kb-search-btn"
      id="kb-search-btn"
      aria-label="Search"
      aria-expanded="false"
      aria-controls="kb-search"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </button>
    <div class="kb-search" id="kb-search" data-inline-search>
      <input
        type="search"
        class="kb-search-input"
        data-search-input
        placeholder="Find a note… (⌘K)"
        aria-label="Search notes"
        autocomplete="off"
      />
      <div class="kb-search-results" data-search-results hidden></div>
    </div>
    <button type="button" class="kb-menu-btn" id="kb-menu-btn" aria-label="Open menu" aria-expanded="false">
      ☰
    </button>
  </div>
</header>

<style>
  /* header — sticky, blurred paper, hairline rule (screens.jsx L24) */
  .kb-chrome {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .kb-chrome__inner {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 0 28px;
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }

  /* brand lockup (screens.jsx L26–29) */
  .kb-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 700;
    font-size: 17px;
    color: var(--ink);
    text-decoration: none;
  }
  .kb-brand__mark {
    width: 30px;
    height: 30px;
    flex: none;
    /* node glyph, no seal badge, transparent — a vivid purple brand mark with pop,
     * brightened a touch more on charcoal so it reads. */
    color: #7c3aed;
  }
  :global([data-theme='dark']) .kb-brand__mark {
    color: #a78bfa;
  }
  .kb-brand__name {
    white-space: nowrap;
  }
  .kb-brand__kicker {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    font-weight: 400;
  }

  /* nav (screens.jsx L11–22, L30–32) */
  .kb-nav {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }
  .kb-nav__link {
    font-family: var(--sans);
    font-size: var(--kb-text-sm);
    color: var(--mut);
    background: transparent;
    border: none;
    padding: 6px 12px;
    border-radius: var(--tsg-radius-sm);
    text-decoration: none;
    cursor: pointer;
  }
  .kb-nav__link.on {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .kb-spacer {
    flex: 1;
  }

  /* theme toggle pill (screens.jsx L34) */
  .kb-theme-toggle {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--mut);
    background: none;
    border: 1px solid var(--rule2);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
    margin-right: 10px;
    line-height: 1;
  }
  /* show the glyph matching the *current* theme target (☾ in light, ☀ in dark) */
  .kb-theme-toggle__dark {
    display: none;
  }
  :global(html[data-theme='dark']) .kb-theme-toggle__light {
    display: none;
  }
  :global(html[data-theme='dark']) .kb-theme-toggle__dark {
    display: inline;
  }

  /* inline search — compact input + dropdown (no modal, no blur) */
  .kb-search {
    position: relative;
  }
  .kb-search-input {
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--ink);
    width: 200px;
    border: 1px solid var(--rule2);
    border-radius: 999px;
    padding: 6px 14px;
    background: var(--card);
    outline: none;
    /* No width transition — animating width reflows the sticky blurred header every frame (choppy ⌘K). */
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .kb-search-input::placeholder {
    color: var(--faint);
  }
  .kb-search-input:focus {
    border-color: var(--accent);
  }
  .kb-search :global([data-search-results]) {
    right: 0;
    width: min(340px, 80vw);
  }
  .kb-search-btn {
    display: none;
  }
  .kb-menu-btn {
    display: none;
    font-family: var(--sans);
    font-size: 18px;
    color: var(--mut);
    background: none;
    border: 1px solid var(--rule2);
    border-radius: var(--tsg-radius-sm);
    padding: 4px 10px;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .kb-chrome__inner {
      padding: 0 16px;
      gap: 12px;
      flex-wrap: wrap;
      height: auto;
      min-height: 56px;
      padding-top: 8px;
      padding-bottom: 8px;
    }
    .kb-brand__kicker {
      display: none;
    }
    .kb-nav {
      display: none;
      width: 100%;
      order: 4;
      flex-direction: column;
      margin: 0;
      padding-bottom: 8px;
    }
    .kb-nav.open {
      display: flex;
    }
    /* phone search: a magnifier button; the field opens full-width under the header row */
    .kb-search-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      padding: 0;
      border: 1px solid var(--rule2);
      border-radius: 999px;
      background: var(--card);
      color: var(--mut);
      cursor: pointer;
    }
    .kb-search {
      display: none;
    }
    .kb-chrome__inner.search-open .kb-search {
      display: block;
      flex: 1 1 100%;
      order: 3;
    }
    .kb-search-input {
      width: 100%;
      font-size: 16px; /* 16px keeps iOS from zooming on focus */
      padding: 10px 14px;
    }
    .kb-search :global([data-search-results]) {
      left: 0;
      right: 0;
      width: auto;
    }
    .kb-menu-btn {
      display: inline-block;
    }
    .kb-theme-toggle {
      margin-right: 0;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('kb-menu-btn');
    var nav = document.querySelector('.kb-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
  (function () {
    var sbtn = document.getElementById('kb-search-btn');
    var bar = document.querySelector('.kb-chrome__inner');
    var input = document.querySelector('.kb-chrome [data-search-input]');
    if (!sbtn || !bar || !input) return;
    function setOpen(open) {
      bar.classList.toggle('search-open', open);
      sbtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) input.focus();
    }
    sbtn.addEventListener('click', function () {
      setOpen(!bar.classList.contains('search-open'));
    });
    // ⌘K on a phone-width window: open the field first so the focus lands on a visible input.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k' && getComputedStyle(sbtn).display !== 'none') {
        setOpen(true);
      }
    }, true);
  })();
</script>
