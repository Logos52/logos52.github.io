---
/** ⌘K search modal — Pagefind full-body index, DS-styled result rows. */
---

<div class="kb-search-root" data-search-root>
  <dialog class="kb-search-dialog" data-search-dialog aria-label="Search notes">
    <div class="kb-search-panel">
      <div class="kb-search-field">
        <input
          type="search"
          data-search-input
          placeholder="Find a note…"
          aria-label="Search"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd>esc</kbd>
      </div>
      <div class="kb-search-results" data-search-results role="listbox" aria-label="Search results"></div>
    </div>
  </dialog>
</div>

<style>
  .kb-search-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(640px, calc(100vw - 32px));
    width: 100%;
    margin: 12vh auto 0;
  }
  .kb-search-dialog::backdrop {
    background: color-mix(in oklab, var(--ink) 28%, transparent);
    backdrop-filter: blur(4px);
  }
  .kb-search-panel {
    background: var(--card);
    border: 1.5px solid var(--rule2);
    border-radius: 16px;
    box-shadow: var(--tsg-shadow);
    overflow: hidden;
  }
  .kb-search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--rule);
  }
  .kb-search-field input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-family: var(--sans);
    font-size: 16px;
    color: var(--ink);
  }
  .kb-search-field kbd {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--faint);
    border: 1px solid var(--rule2);
    border-radius: 4px;
    padding: 2px 6px;
    background: var(--raised);
  }
  .kb-search-results {
    max-height: min(52vh, 420px);
    overflow-y: auto;
    padding: 8px;
  }
  :global(.kb-search-empty) {
    margin: 12px 10px;
    font-size: 13px;
    color: var(--faint);
  }
  :global(.kb-search-row) {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 2px 12px;
    width: 100%;
    text-align: left;
    border: none;
    background: transparent;
    border-radius: var(--tsg-radius-sm);
    padding: 10px 12px;
    cursor: pointer;
    font-family: var(--sans);
  }
  :global(.kb-search-row.on),
  :global(.kb-search-row:hover) {
    background: var(--accent-soft);
  }
  :global(.kb-search-row__title) {
    grid-column: 1;
    font-family: var(--ming);
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink);
  }
  :global(.kb-search-row__domain) {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }
  :global(.kb-search-row__excerpt) {
    grid-column: 1;
    font-size: 12px;
    color: var(--mut);
    line-height: 1.45;
  }
</style>

<script>
  import { initSearchPalette } from '../islands/search-palette';
  document.querySelectorAll('[data-search-root]').forEach((el) => initSearchPalette(el as HTMLElement));
</script>