---
import { DOMAINS } from '../lib/types';
import type { Domain } from '../lib/types';

export interface Props {
  title: string;
  summary?: string;
  domain?: Domain | string;
  kind?: string;
  meta?: string;
  href?: string;
}

const { title, summary, domain, kind, meta, href } = Astro.props;

// Resolve the wash hue: one of the 6 domain keys -> var(--d-<key>);
// otherwise treat `domain` as a literal CSS color/token; fall back to accent.
const hue =
  domain && (DOMAINS as readonly string[]).includes(domain)
    ? `var(--d-${domain})`
    : (domain || 'var(--accent)');

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class="kb-notecard"
  style={`
    --nc-hue:${hue};
    border:1px solid color-mix(in oklab, ${hue} 22%, var(--rule));
    background:color-mix(in oklab, ${hue} 5%, var(--card));
  `}
>
  {kind && <span class="nc-kind">{kind}</span>}
  <span class="nc-title" style={kind ? 'margin-top:5px' : 'margin-top:0'}>{title}</span>
  {summary && <span class="nc-summary">{summary}</span>}
  {meta && <span class="nc-meta">{meta}</span>}
</Tag>

<style>
  .kb-notecard {
    display: block;
    text-decoration: none;
    border-radius: var(--tsg-radius);
    padding: 15px 16px;
    box-shadow: var(--tsg-shadow);
    transition:
      transform 0.12s var(--ease-standard),
      border-color 0.12s,
      box-shadow 0.12s;
    color: var(--ink);
  }
  a.kb-notecard {
    cursor: pointer;
  }
  .nc-kind {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--nc-hue);
  }
  .nc-title {
    display: block;
    font-family: var(--ming);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .nc-summary {
    display: block;
    font-size: 12px;
    color: var(--mut);
    margin-top: 4px;
    line-height: 1.45;
  }
  .nc-meta {
    display: block;
    margin-top: 11px;
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
  }
</style>
