---
export interface Props {
  title: string;
  footer?: string;
  footerHref?: string;
}

const { title, footer, footerHref } = Astro.props;
---

<section class="kb-pulse">
  <h2 class="pulse-title">{title}</h2>
  <slot />
  {footer && (
    <a href={footerHref ?? '#'} class="pulse-footer">{footer}</a>
  )}
</section>

<style>
  .kb-pulse {
    border: 1px solid var(--rule);
    background: var(--card);
    border-radius: var(--tsg-radius);
    padding: 18px 20px;
    box-shadow: var(--tsg-shadow);
  }
  .pulse-title {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 12px;
    font-weight: 600;
  }
  .pulse-footer {
    display: inline-block;
    margin-top: 12px;
    font-size: 12.5px;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px dotted var(--accent);
  }
</style>
