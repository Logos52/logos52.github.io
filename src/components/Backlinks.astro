---
import type { Backlink } from '../lib/types';
import { slugToUrl } from '../lib/slug';

interface Props {
  items: Backlink[];
}
const { items } = Astro.props;
const SHOWN = 5;
const head = items.slice(0, SHOWN);
const rest = items.slice(SHOWN);
---

{
  items.length > 0 && (
    <section class="linked" aria-label="Linked from" data-pagefind-ignore>
      <h2 class="linked__title">Linked from</h2>
      <div>
        {head.map((b) => (
          <a href={slugToUrl(b.slug)} class="linked__row">
            {b.title}
            {b.context && <span class="linked__ctx">{b.context}</span>}
          </a>
        ))}
      </div>
      {rest.length > 0 && (
        <details class="linked__more">
          <summary>{rest.length} more</summary>
          <div>
            {rest.map((b) => (
              <a href={slugToUrl(b.slug)} class="linked__row">
                {b.title}
                {b.context && <span class="linked__ctx">{b.context}</span>}
              </a>
            ))}
          </div>
        </details>
      )}
    </section>
  )
}
