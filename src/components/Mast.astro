---
interface Props {
  active?: string;
}
const { active } = Astro.props;
const nav = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'map', label: 'Map', href: '/map/' },
  { id: 'projects', label: 'Projects', href: '/projects/' },
  { id: 'journal', label: 'Journal', href: '/journal/' },
  { id: 'about', label: 'About', href: '/about/' },
];
---

<header class="mast">
  <a class="mast__mark" href="/">Logos52</a>
  <div class="mast__tools">
    <div class="find" data-inline-search>
      <input
        type="search"
        class="find__input"
        data-search-input
        placeholder="Search"
        aria-label="Search notes"
        autocomplete="off"
      />
      <div class="find__results" data-search-results hidden></div>
    </div>
    <button type="button" class="mast__icon" id="search-btn" aria-label="Search" aria-expanded="false">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
    </button>
    <button type="button" class="mast__burger" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>
<div class="menu" id="menu" hidden>
  <nav class="menu__nav" aria-label="Sections">
    {
      nav.map((item) => (
        <a class="menu__link" href={item.href} aria-current={active === item.id ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</div>

<script is:inline>
  (function () {
    var menuBtn = document.getElementById('menu-btn');
    var menu = document.getElementById('menu');
    var searchBtn = document.getElementById('search-btn');
    var bar = document.querySelector('.mast');
    var input = document.querySelector('[data-search-input]');
    if (menuBtn && menu) {
      menuBtn.addEventListener('click', function () {
        var open = menu.hasAttribute('hidden');
        if (open) menu.removeAttribute('hidden');
        else menu.setAttribute('hidden', '');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      });
    }
    if (searchBtn && bar && input) {
      function setSearch(open) {
        bar.classList.toggle('is-search', open);
        searchBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) input.focus();
      }
      searchBtn.addEventListener('click', function () {
        setSearch(!bar.classList.contains('is-search'));
      });
      document.addEventListener(
        'keydown',
        function (e) {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k' && getComputedStyle(searchBtn).display !== 'none') {
            setSearch(true);
          }
        },
        true,
      );
    }
  })();
</script>
