---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { buildJournalBoard, daysInMonth, firstWeekday, monthParts } from '../lib/journal-board';
const notes = await getCollection('notes');
const board = buildJournalBoard(notes);
function cells(id: string) {
  const { year, month } = monthParts(id);
  const active = new Set<number>();
  const found = board.months.find((m) => m.id === id);
  for (const week of found?.weeks ?? []) for (const entry of week.entries) active.add(entry.day);
  for (const week of found?.weeks ?? []) for (const item of week.news) active.add(item.day);
  const pad = firstWeekday(year, month);
  const total = daysInMonth(year, month);
  const out: { x: number; y: number; day: number; on: boolean }[] = [];
  for (let day = 1; day <= total; day++) {
    const index = pad + day - 1;
    out.push({ x: (index % 7) * 14, y: Math.floor(index / 7) * 14, day, on: active.has(day) });
  }
  return out;
}
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
---

<Base title="Journal — Logos52" description="The lab notebook, week by week." section="journal">
  <div class="page" id="page-journal">
    <header class="mast"><span class="title">Journal</span></header>
    <div class="jr" data-view="months" data-views>
      <nav class="jr-rail" aria-label="Journal months">
        <div class="jr-cals">
          {
            board.months.map((month, index) => (
              <div class:list={['jr-cal', { on: index === 0 }]} data-m={month.id}>
                <svg class="jm-cal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 95 80" width="95" height="80" role="img" aria-label={month.heading}>
                  {
                    cells(month.id).map((cell) => (
                      <rect x={cell.x} y={cell.y} width="11" height="11" rx="2" fill={cell.on ? 'oklch(0.56 0.15 150)' : 'currentColor'} fill-opacity={cell.on ? '1' : '0.07'}>
                        <title>{cell.day}</title>
                      </rect>
                    ))
                  }
                </svg>
              </div>
            ))
          }
        </div>
        <div class="jr-year">2026</div>
        {
          board.months.map((month, index) => (
            <div class:list={['jr-m', { on: index === 0 }]} data-m={month.id}>
              <a class="jr-mn" href={`#${month.id}`} data-month={month.id}>{monthNames[monthParts(month.id).month - 1]}</a>
              <div class="jr-wks">
                {
                  month.weeks.map((week) => (
                    <a class="jr-wk" href={`#${week.id}`}>
                      <span class="jr-wn">{week.label.slice(0, 2)}</span>
                      <span class="jr-wd">{week.label.replace(/^W\d · /, '')}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          ))
        }
        <div class="jr-thnav">
          {board.threads.map((thread) => <a class="jr-mn" href={`#thread-${thread.name.toLowerCase().replace(/\s+/g, '-')}`}>{thread.name}</a>)}
        </div>
      </nav>
      <div class="jr-main">
        <div class="jr-views" role="group" aria-label="View">
          <button type="button" data-view="months" aria-pressed="true">Months</button>
          <button type="button" data-view="tracks" aria-pressed="false">Two tracks</button>
          <button type="button" data-view="year" aria-pressed="false">Year</button>
          <button type="button" data-view="threads" aria-pressed="false">Threads</button>
          <button type="button" class="jr-newsbtn" aria-pressed="true">AI news</button>
        </div>
        <div class="jv on" data-view="months">
          {
            board.months.map((month, index) => (
              <section class:list={['jr-month', { on: index === 0 }]} id={month.id} data-m={month.id}>
                <h1 class="jr-h">{month.heading}</h1>
                {month.syn && <p class="jm-syn">{month.syn}</p>}
                {
                  month.weeks.map((week) => (
                    <div class="jr-week" id={week.id}>
                      <h2 class="jr-wh"><span class="jr-wn">{week.label.slice(0, 2)}</span> · {week.label.replace(/^W\d · /, '')}</h2>
                      {week.syn && <p class="jr-syn">{week.syn}</p>}
                      <div class="jr-rows">
                        {
                          week.entries.map((entry) => (
                            <a class="jr-row" href={entry.href}>
                              <span class="jr-d">{entry.day}</span>
                              <span>{entry.title}</span>
                            </a>
                          ))
                        }
                      </div>
                      {
                        week.news.length > 0 && (
                          <div class="jr-news">
                            <div class="jr-nl">AI news</div>
                            {
                              week.news.map((item) => (
                                <a class="jr-row" href={item.href} target="_blank" rel="noopener">
                                  <span class="jr-d">{item.day}</span>
                                  <span>{item.title} <span class="jr-src">{item.source}</span></span>
                                </a>
                              ))
                            }
                          </div>
                        )
                      }
                    </div>
                  ))
                }
              </section>
            ))
          }
        </div>
        <div class="jv" data-view="tracks">
          {
            board.months.map((month, index) => (
              <section class:list={['jt-month', { on: index === 0 }]} data-m={month.id}>
                <h1 class="jr-h">{month.heading}</h1>
                {month.syn && <p class="jm-syn">{month.syn}</p>}
                <div class="jt-heads"><span>Entries</span><span>AI news</span></div>
                {
                  month.weeks.map((week) => (
                    <div class="jt-week" id={`${week.id}-tracks`}>
                      <h2 class="jr-wh">{week.label}</h2>
                      <div class="jt-cols">
                        <div>
                          {
                            week.entries.map((entry) => (
                              <a class="jr-row" href={entry.href}>
                                <span class="jr-d">{entry.day}</span>
                                <span>{entry.title}</span>
                              </a>
                            ))
                          }
                        </div>
                        <div class="jt-news">
                          {
                            week.news.map((item) => (
                              <a class="jr-row" href={item.href} target="_blank" rel="noopener">
                                <span class="jr-d">{item.day}</span>
                                <span>{item.title} <span class="jr-src">{item.source}</span></span>
                              </a>
                            ))
                          }
                        </div>
                      </div>
                    </div>
                  ))
                }
              </section>
            ))
          }
        </div>
        <div class="jv" data-view="year">
          {
            board.months.map((month) => (
              <a class="jy-row" href={`#${month.id}`} data-month={month.id}>
                <svg class="jm-cal" viewBox="0 0 95 80" width="95" height="67" aria-hidden="true">
                  {
                    cells(month.id).map((cell) => (
                      <rect x={cell.x} y={cell.y} width="11" height="11" rx="2" fill={cell.on ? 'oklch(0.56 0.15 150)' : 'currentColor'} fill-opacity={cell.on ? '1' : '0.07'} />
                    ))
                  }
                </svg>
                <span>
                  <b>{month.heading}</b>
                  {month.syn && <span class="jr-syn">{month.syn.split('. ')[0]}.</span>}
                </span>
              </a>
            ))
          }
        </div>
        <div class="jv" data-view="threads">
          {
            board.threads.map((thread) => (
              <section id={`thread-${thread.name.toLowerCase().replace(/\s+/g, '-')}`}>
                <h2 class="sec-h">{thread.name}</h2>
                {
                  thread.entries.map((entry) => (
                    <a class="jr-row" href={entry.href}>
                      <span class="jr-d">{entry.day}</span>
                      <span>{entry.title}</span>
                    </a>
                  ))
                }
              </section>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</Base>
