---
/**
 * journal.astro — the Journal landing, rendered as a clean compact spread of your journal/index.md
 * (matches the Notes/About simple-page style at the global content width).
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';

const entry = await getEntry('notes', 'journal/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;

// "Top of mind" = the active projects, shown as a local graph (1-hop neighborhood of each).
const JOURNAL_PROJECTS = ['projects/tsumugu', 'projects/wnac', 'projects/cos', 'projects/llm-knowledge-base'];
---

<Base title="Journal" description="Working notes, decisions, and what's top of mind." active="journal">
  <main class="journal-page">
    <div class="wrap journal-grid">
      <article class="prose">
        <nav class="journal-nav" aria-label="Journal sections">
          <a href="/journal/calendar/">Calendar</a>
        </nav>
        {Content ? <Content /> : <p>Journal not found.</p>}
      </article>
      <aside class="topofmind">
        <h2 class="topofmind__head">Top of mind</h2>
        <Constellation
          mode="local"
          seeds={JOURNAL_PROJECTS}
          hops={1}
          orient="vertical"
          height="clamp(360px, 66vh, 600px)"
        />
      </aside>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 34px 28px 52px;
  }
  .journal-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .topofmind {
    position: sticky;
    top: 80px;
    min-width: 0;
  }
  .topofmind__head {
    font-family: var(--ming);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .prose {
    margin-top: 0;
    min-width: 0;
  }
  .prose :global(h1) {
    font-family: var(--ming);
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-family: var(--ming);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 1.7rem 0 0.6rem;
    color: var(--ink);
  }
  .prose :global(h3) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 1.4rem 0 0.5rem;
    color: var(--mut);
  }
  .prose :global(p) {
    font-size: 13.5px;
    color: var(--mut);
    line-height: 1.6;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.05rem;
    margin: 0.5rem 0;
  }
  .prose :global(li) {
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0.3rem 0;
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .prose :global(a:hover) {
    text-decoration: underline;
  }
  .prose :global(.missing) {
    color: var(--faint);
    cursor: default;
  }
  .prose :global(img) {
    max-width: 100%;
    border-radius: 10px;
    display: block;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--rule2);
    margin: 1rem 0;
    padding: 0.2rem 0 0.2rem 1rem;
    color: var(--mut);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    margin: 0.6rem 0 1.4rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 6px 10px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .prose :global(td) {
    color: var(--mut);
  }
  .journal-nav {
    margin: 0 0 1rem;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .journal-nav a {
    color: var(--accent);
    text-decoration: none;
    border: 1px solid var(--rule2);
    border-radius: 999px;
    padding: 4px 12px;
    background: var(--card);
  }
  .journal-nav a:hover {
    border-color: var(--accent);
  }
  @media (max-width: 820px) {
    .journal-grid {
      grid-template-columns: 1fr;
    }
    .topofmind {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
  }
</style>
