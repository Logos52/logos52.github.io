---
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';

const entry = await getEntry('notes', 'journal/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<Shell title="Journal" description="Working notes, decisions, and what's top of mind." active="journal">
  <main class="reading">
    <article class="prose">
      <nav class="crumb" aria-label="Journal sections">
        <a href="/journal/calendar/">Calendar</a>
      </nav>
      {Content ? <Content /> : <p>Journal not found.</p>}
    </article>
  </main>
</Shell>
