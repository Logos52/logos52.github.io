---
/**
 * notes.astro — the Notes index: renders hand-curated `notes/index.md` (Condensed + Hubs).
 * The full wiki inventory lives in gitignored `notes/catalog.md` for agents only.
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';

const entry = await getEntry('notes', 'notes/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<Base title="Notes" description="Entry points into the wiki — doctrine pages, hubs, and orientation." active="notes">
  <main class="notes-page">
    <div class="wrap">
      <Constellation mode="full" height="clamp(340px, 56vh, 580px)" />
      <article class="kb-shell-prose notes-prose">
        {Content ? <Content /> : <p>Index not found.</p>}
      </article>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 28px 28px 52px;
  }
  .notes-prose {
    display: block;
    margin-top: 26px;
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
  }
</style>