---
/**
 * notes.astro — the simple Notes index: renders your `notes/index.md` (Hubs & Condensed list +
 * Full Catalog table) as a clean list page, matching the original Quartz layout.
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';

const entry = await getEntry('notes', 'notes/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<Base title="Notes" description="Every note in the knowledge base, across six domains." active="notes">
  <main class="notes-page">
    <div class="wrap">
      <Constellation mode="full" height="clamp(340px, 56vh, 580px)" />
      <article class="prose">
        {Content ? <Content /> : <p>Index not found.</p>}
      </article>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 28px 28px 52px;
  }
  .prose {
    display: block;
    margin-top: 26px;
  }
  .prose :global(h1) {
    font-family: var(--ming);
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-family: var(--ming);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 1.7rem 0 0.6rem;
    color: var(--ink);
  }
  .prose :global(h3) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 1.4rem 0 0.5rem;
    color: var(--mut);
  }
  .prose :global(p) {
    font-size: 13.5px;
    color: var(--mut);
    line-height: 1.6;
  }
  .prose :global(ul) {
    padding-left: 1.05rem;
    margin: 0.5rem 0;
  }
  .prose :global(li) {
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0.3rem 0;
    color: var(--ink);
  }
  .prose :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .prose :global(a:hover) {
    text-decoration: underline;
  }
  .prose :global(.missing) {
    color: var(--faint);
    text-decoration: none;
    cursor: default;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    margin: 0.6rem 0 1.4rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 6px 10px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(th) {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }
  .prose :global(td) {
    color: var(--mut);
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
  }
</style>
