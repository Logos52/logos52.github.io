---
import Shell from '../layouts/Shell.astro';
import { DOMAINS, DOMAIN_LABELS, DOMAIN_STANCES, type Domain } from '../lib/types';
import { slugifyFilePath, slugToUrl } from '../lib/slug';

const objective =
  'This wiki is compiled with agents, but the human still sets direction, judges what ships, and owns what the pages claim.';

const topOfMind: string[] = [
  'Whether story arcs need a moral core before the character risks losing something they love.',
  'How much of daily life still belongs on personal pages that stay off the public site.',
  'Where political arguments hold up when you trace them past the headline.',
];
if (topOfMind.length !== 3) throw new Error('Top of mind holds exactly 3 lines on the home page.');

const omitted =
  'Raw sources, private notes, financial detail, and workbench drafts stay out of the published wiki.';

const buildersHref = slugToUrl(
  slugifyFilePath("wiki/Systems/AI & Agentic Systems/Builders' Logs 2026.md"),
);
---

<Shell title="Logos52" description={objective} active="home">
  <!-- design-archive/old-design/src/styles/chrome.css -->
  <main class="page kb-chrome">
  <style>
    .kb-chrome { font-family: "Hanken Grotesk", sans-serif; color: #5C63E6; }
  </style>
    <p class="lede" data-home-objective>{objective}</p>

    <section class="band" aria-labelledby="logs-head">
      <h2 id="logs-head" class="band__title">Builders' Logs 2026</h2>
      <ul class="word">
        <li>
          <a class="word__link" href={buildersHref}>
            <span class="word__title">Open Builders' Logs 2026</span>
            <span class="word__meta">
              Thirteen agent builders in bridge order, with Grok and Anthropic lab sections, dated source
              links, and person pages.
            </span>
          </a>
        </li>
      </ul>
    </section>

    <section class="band" aria-labelledby="start-head">
      <h2 id="start-head" class="band__title">Where to start</h2>
      <ul class="word">
        {
          DOMAINS.map((d: Domain) => (
            <li>
              <a class="word__link" href={`/domains/${d}/`}>
                <span class="word__title">{DOMAIN_LABELS[d]}</span>
                <span class="word__meta">{DOMAIN_STANCES[d]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="band" aria-labelledby="mind-head">
      <h2 id="mind-head" class="band__title">Top of mind</h2>
      <ul class="lines">
        {topOfMind.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <p class="quiet">{omitted}</p>
  </main>
</Shell>
