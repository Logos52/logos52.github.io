---
/**
 * index.astro — the Logos52 home, matched to the original Quartz HomeLanding: compact, narrow
 * (~original --pageWidth), left-aligned hero, inline search, constellation + legend, Open
 * questions / Today's retrieval, Start here (intent doors), and three hub-list columns.
 */
import { existsSync, readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
import Base from '../layouts/Base.astro';
import DomainChip from '../components/DomainChip.astro';
import Constellation from '../components/Constellation.astro';
import { slugifyFilePath, slugToUrl } from '../lib/slug';
import { DOMAIN_LABELS, type Domain } from '../lib/types';

interface HomeData {
  hero?: { title?: string; lede?: string };
  questions?: string[];
  todaysRetrieval?: { kind?: string; title?: string; prompt?: string; queueCount?: number; slug?: string };
}
const HOME_JSON = 'kb-astro/site-data/home.json';
let home: HomeData | null = null;
try {
  if (existsSync(HOME_JSON)) home = JSON.parse(readFileSync(HOME_JSON, 'utf8')) as HomeData;
} catch {
  home = null;
}

const notes = await getCollection('notes');
const hero = home?.hero ?? {
  title: 'A second brain for learning systems & agentic engineering',
  lede: 'Linked notes on learning systems, language study, and software work with LLM agents.',
};
// "Currently" — a short now-band: what I'm building / learning / reading / chewing on. Hand-curated;
// edit these freely. (Replaced the Open-questions + Today's-retrieval pulse cards.)
// "Top of mind" — open questions about where AI is going and how to shape it (personal + society).
// Pose the question; link to the note that addresses it. Standard: 02 - System/Writing Standards.md
// → High-Signal Front-Facing Pages → Open Questions Stay Open. Edit freely; keep them in-lane.
type Mind = { q: string; links: { t: string; href: string }[] };
const L = (t: string, p: string) => ({ t, href: slugToUrl(slugifyFilePath(p)) });
const topOfMind: Mind[] = [
  {
    q: 'What stays human as the models match generativity',
    links: [
      L('Higher-Order Generativity vs Judgment', 'wiki/Concepts/Higher-Order Generativity vs Higher-Order Judgment'),
      L('A Motorcycle for the Mind', 'wiki/Concepts/A Motorcycle for the Mind'),
      L('The AI Industrial Revolution', 'wiki/Concepts/The AI Industrial Revolution'),
    ],
  },
  {
    q: 'Where leaning on AI builds understanding',
    links: [
      L('Understanding Bottleneck', 'wiki/Concepts/Understanding Bottleneck'),
      L('Are You Thinking, or Just Consuming', 'wiki/Concepts/Are You Thinking, or Just Consuming'),
      L('The Screen Inferiority Effect', 'wiki/Concepts/The Screen Inferiority Effect'),
    ],
  },
  {
    q: 'If a generation offloads its thinking to AI, what are the second-order effects?',
    links: [
      L('Epistemic Exceptionalism', 'wiki/Red Team/Epistemic Exceptionalism'),
      L('The Shortcut Problem', 'wiki/Concepts/The Shortcut Problem'),
      L('The Age of Nonlinear Returns', 'wiki/Concepts/The Age Of Nonlinear Returns'),
    ],
  },
];

// Intent doors ("Start here") — route a visitor by intent, not topic. slug → a note path
// (resolved via cardHref); the graph door uses a direct href. Titles/subs are mined from each
// destination note (concrete, note-grounded). Colors: Understand/Apply ride DS theme tokens
// (--violet / --cool, auto-lift in dark); Learn/Decode/Explore are seeded in .start-here CSS with a
// dark override. Five doors cover all three hero domains: learning · agentic · language.
type Door = { intent: string; icon: string; title: string; sub: string; color: string; slug?: string; href?: string };
const startHere: Door[] = [
  { intent: 'Understand', icon: 'ti-bulb',      title: 'Build the Factory',            sub: 'When agents do the work, you build the system that ships it.',      color: 'var(--i-understand)', slug: 'wiki/Concepts/The-AI-Industrial-Revolution' },
  { intent: 'Apply',      icon: 'ti-robot',     title: 'Raise the Floor',              sub: 'Ask in plain language; the agent edits, runs, iterates.',          color: 'var(--i-apply)',      slug: 'wiki/Systems/AI & Agentic Systems/Vibe-Coding' },
  { intent: 'Learn',      icon: 'ti-school',    title: 'Self Correction',              sub: 'See three levels at once, and adjust when a technique stalls.',     color: 'var(--i-learn)',      slug: 'wiki/Syntheses/First-Principles-of-Learning' },
  { intent: 'Decode',     icon: 'ti-language',  title: '立 — Three Jobs, One Shape',    sub: 'Meaning in 端, sound in 拉, empty in 音 — the role is per character.', color: 'var(--i-decode)',     slug: 'wiki/Language/Chinese/How-Chinese-Characters-Work' },
  { intent: 'Explore',    icon: 'ti-affiliate', title: 'Follow the Threads',           sub: 'Which notes are hubs, and how the six domains connect.',                color: 'var(--i-explore)',    href: '/map/' },
];

type Hub = { title: string; icon: string; color: string; slug: string; tag?: string; countPrefix?: string };
const dimensionHubs: Hub[] = [
  { title: 'Deep Processing', icon: 'ti-affiliate', color: '#8dc63f', slug: 'wiki/Dimensions/Deep-Processing', tag: 'deep-processing' },
  { title: 'Retrieval', icon: 'ti-circle-arrow-up', color: '#f2c94c', slug: 'wiki/Dimensions/Retrieval', tag: 'retrieval' },
  { title: 'Self-Regulation', icon: 'ti-steering-wheel', color: '#f47b20', slug: 'wiki/Dimensions/Self-Regulation', tag: 'self-regulation' },
  { title: 'Self-Management', icon: 'ti-settings', color: '#2d9cdb', slug: 'wiki/Dimensions/Self-Management', tag: 'self-management' },
  { title: 'Mindset', icon: 'ti-brain', color: '#3fc1b0', slug: 'wiki/Dimensions/Mindset', tag: 'mindset' },
];
const lifeHubs: Hub[] = [
  { title: 'Health', icon: 'ti-heartbeat', color: '#2fa36b', slug: 'wiki/Dimensions/Self-Management', countPrefix: 'wiki/Dimensions/Self-Management' },
  { title: 'Money', icon: 'ti-wallet', color: '#2fa36b', slug: 'wiki/Money/Money, Condensed', countPrefix: 'wiki/Money' },
  { title: '中文', icon: 'ti-language', color: '#ffb000', slug: 'wiki/Language/Chinese/How-Chinese-Characters-Work', countPrefix: 'wiki/Language/Chinese' },
  { title: 'Minimalism', icon: 'ti-box', color: '#9aa0a6', slug: 'wiki/Minimalism/Minimalism-as-Systems-Design', countPrefix: 'wiki/Minimalism' },
  { title: 'Condensed Notes', icon: 'ti-book-2', color: '#734bb2', slug: 'wiki/Syntheses/Learning, Condensed', countPrefix: 'wiki/Syntheses' },
];
const executionHubs: Hub[] = [
  { title: 'Agentic Engineering', icon: 'ti-robot', color: '#4f9dff', slug: 'wiki/Systems/AI & Agentic Systems/Agentic-Engineering', countPrefix: 'wiki/Systems/AI & Agentic Systems' },
  { title: 'Learning Systems', icon: 'ti-network', color: '#8dc63f', slug: 'wiki/Syntheses/First-Principles-of-Learning', countPrefix: 'wiki/Syntheses' },
  { title: 'Focus Management', icon: 'ti-target', color: '#ff6fa3', slug: 'wiki/Self-Management/Focus-Management---How-to-Enter--and--Recover-Inside-a-Work-Block', countPrefix: 'wiki/Self Management' },
  { title: 'Decision Making', icon: 'ti-checklist', color: '#ff8a3d', slug: 'wiki/Decision-Making/Decision-Making', countPrefix: 'wiki/Decision Making' },
  { title: 'Generativity', icon: 'ti-bulb', color: '#7f55a0', slug: 'wiki/Concepts/Higher-Order-Generativity-vs-Higher-Order-Judgment', countPrefix: 'wiki/Concepts' },
];
const hubColumns = [
  { title: 'Five Dimensions', items: dimensionHubs },
  { title: 'Life Systems', items: lifeHubs },
  { title: 'Knowledge & Execution', items: executionHubs },
];

const tagCount = new Map<string, number>();
for (const n of notes) {
  const raw = (n.data as Record<string, unknown>).tags;
  const tags = Array.isArray(raw) ? raw.map(String) : raw ? [String(raw)] : [];
  for (let t of tags) {
    t = t.trim().toLowerCase().replace(/\s+/g, '-');
    if (t) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
  }
}
const slugs = notes.map((n) => n.id);
function prefixCount(rawPrefix: string): number {
  const base = slugifyFilePath(rawPrefix);
  let c = 0;
  for (const s of slugs) if (s === base || s.startsWith(base + '/')) c++;
  return c;
}
function hubCount(h: Hub): number {
  if (h.tag && tagCount.has(h.tag)) return tagCount.get(h.tag)!;
  if (h.countPrefix) return prefixCount(h.countPrefix);
  return prefixCount(h.slug.replace(/\/[^/]+$/, ''));
}
const hubHref = (slug: string) => slugToUrl(slugifyFilePath(slug));
const cardHref = (slug: string) => slugToUrl(slugifyFilePath(slug));
const chipDomains: Domain[] = ['learning', 'agentic', 'language', 'focus', 'mind', 'gen'];
const DOMAIN_ICONS: Record<Domain, string> = {
  learning: 'ti-school',
  agentic: 'ti-robot',
  language: 'ti-language',
  focus: 'ti-target',
  mind: 'ti-brain',
  gen: 'ti-bulb',
};
---

<Base title={hero.title ?? 'Logos52'} description={hero.lede} active="home">
  <main class="home">
    <div class="wrap">
      <section class="hero">
        <h1 class="hero__title">{hero.title}</h1>
        <p class="hero__lede">{hero.lede}</p>
      </section>
      <div class="hero__search" data-inline-search>
        <svg class="hero__search-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zm9 16-4.35-4.35" />
        </svg>
        <input type="search" class="hero__search-input" data-search-input placeholder="Find a note…" aria-label="Search notes" autocomplete="off" />
        <div class="hero__search-results" data-search-results hidden></div>
      </div>

      <section class="map">
        <Constellation height="clamp(150px, 17vh, 200px)" />
        <div class="map__legend">
          {chipDomains.map((d) => <DomainChip label={DOMAIN_LABELS[d]} domain={d} icon={DOMAIN_ICONS[d]} href={`/domains/${d}/`} />)}
        </div>
      </section>

      <section class="start-here">
        <h2 class="start-here__head">Start here</h2>
        <div class="start-here__doors">
          {startHere.map((d) => (
            <a class="door" style={`--dc:${d.color}`} href={d.href ?? cardHref(d.slug!)}>
              <span class="door__kind"><i class={`ti ${d.icon}`} /><span class="door__intent">{d.intent}</span></span>
              <span class="door__title">{d.title}</span>
              <span class="door__sub">{d.sub}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="topmind">
        <h2 class="topmind__head">Top of mind</h2>
        <ul class="topmind__list">
          {topOfMind.map((m) => (
            <li class="topmind__item">
              <p class="topmind__q">{m.q}</p>
              <p class="topmind__links">
                {m.links.map((l, i) => (
                  <span>{i > 0 ? ' · ' : ''}<a href={l.href}>{l.t}</a></span>
                ))}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <section class="hub-lists">
        {hubColumns.map((col) => (
          <div class="hub-card">
            <div class="hub-card__title">{col.title}</div>
            <ul class="hub-list">
              {col.items.map((h) => (
                <li>
                  <a href={hubHref(h.slug)}>
                    <i class={`ti ${h.icon} hub-list__icon`} style={`color:${h.color}`} aria-hidden="true"></i>
                    <span class="hub-list__title">{h.title}</span>
                    <span class="hub-list__count">{hubCount(h)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 0 28px;
  }
  .home {
    padding-bottom: 40px;
  }

  /* hero — left, compact */
  .hero {
    max-width: 60ch;
    padding: 40px 0 0;
  }
  .hero__title {
    font-family: var(--ming);
    font-weight: 500;
    font-size: 1.8rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .hero__lede {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.55;
    color: var(--mut);
    margin: 0;
  }
  .hero__search {
    position: relative;
    width: 46%;
    min-width: 12rem;
    margin: 14px 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--card);
    border: 1px solid var(--rule2);
    border-radius: 8px;
    padding: 7px 12px;
    box-shadow: var(--tsg-shadow-sm, var(--tsg-shadow));
    transition: border-color var(--dur-base);
  }
  .hero__search:focus-within {
    border-color: var(--accent);
  }
  .hero__search-icon {
    color: var(--faint);
    flex-shrink: 0;
  }
  .hero__search-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink);
  }
  .hero__search-input::placeholder {
    color: var(--faint);
  }
  .hero__search :global([data-search-results]) {
    left: 0;
    right: 0;
    top: 100%;
  }

  /* constellation + legend */
  .map {
    margin: 18px 0 0;
  }
  .map__graph-link {
    font-family: var(--sans);
    font-size: 11px;
    color: var(--accent);
    text-decoration: none;
    margin-left: auto;
  }
  .map__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: center;
    padding: 12px 2px 0;
  }

  /* currently — a full-width "now" band (replaces the open-questions / retrieval pulse) */
  .topmind {
    margin-top: 18px;
  }
  .topmind__head {
    font-family: var(--ming);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .topmind__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .topmind__q {
    font-family: var(--ming);
    font-size: 14px;
    color: var(--ink);
    margin: 0 0 2px;
  }
  .topmind__links {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--mut);
    margin: 0;
  }
  .topmind__links a {
    color: var(--accent);
    text-decoration: none;
  }
  .topmind__links a:hover {
    text-decoration: underline;
  }

  /* start here — intent doors (wash cards, icon left of the intent label) */
  .start-here {
    margin-top: 28px;
    /* Door seeds. Understand/Apply ride the DS theme tokens (auto-lift in dark);
       Learn/Decode/Explore are seeded here and lifted in the dark override below.
       Decode = ochre-gold: distinct from Explore's orange, apt for the 中文 door. */
    --i-understand: var(--violet);
    --i-apply: var(--cool);
    --i-learn: #5a8f4e;
    --i-decode: #9d7b2e;
    --i-explore: #c2703f;
  }
  .start-here__head {
    font-family: var(--ming);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .start-here__doors {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .door {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 15px;
    border-radius: var(--tsg-radius);
    border: 1px solid color-mix(in oklab, var(--dc) 22%, var(--rule));
    background: color-mix(in oklab, var(--dc) 6%, var(--card));
    box-shadow: var(--tsg-shadow);
    text-decoration: none;
    transition:
      transform var(--dur-fast),
      border-color var(--dur-base);
  }
  .door:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--dc) 40%, var(--rule));
  }
  .door__kind {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .door__kind .ti {
    font-size: 12px;
    color: var(--dc);
    opacity: 0.7;
    line-height: 1;
  }
  .door__intent {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dc);
  }
  .door__title {
    font-family: var(--ming);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
  .door__sub {
    font-size: 11.5px;
    color: var(--mut);
    line-height: 1.45;
  }
  /* Dark: brighten the non-token seeds so the wash + label keep their bite. */
  :global([data-theme='dark']) .start-here {
    --i-learn: #7bb06d;
    --i-decode: #d8b35a;
    --i-explore: #dd8a5f;
  }

  /* three hub-list columns — compact (matches the original sizes) */
  .hub-lists {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 26px;
  }
  .hub-card {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--tsg-radius);
    padding: 14px 16px;
    box-shadow: var(--tsg-shadow);
  }
  .hub-card__title {
    font-family: var(--ming);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0 0 4px;
  }
  .hub-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hub-list li {
    border-top: 1px solid var(--rule);
  }
  .hub-list li:first-child {
    border-top: none;
  }
  .hub-list a {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 7px 2px;
    text-decoration: none;
    color: var(--ink);
  }
  .hub-list a:hover .hub-list__title {
    color: var(--accent);
  }
  .hub-list__icon {
    font-size: 16px;
    line-height: 1;
    flex-shrink: 0;
  }
  .hub-list__title {
    font-size: 13px;
  }
  .hub-list__count {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
  }

  @media (max-width: 820px) {
    .hub-lists {
      grid-template-columns: 1fr;
    }
    .start-here__doors {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 640px) {
    .start-here__doors {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Odd count: let the last door (Explore) span the row instead of orphaning. */
    .start-here__doors .door:last-child {
      grid-column: 1 / -1;
    }
    .wrap {
      padding: 0 16px;
    }
    .hero__search {
      width: 100%;
    }
    .map__graph-link {
      margin-left: 0;
    }
  }
</style>
