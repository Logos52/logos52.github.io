---
import { readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FlatGraph from '../components/FlatGraph.astro';
import { deriveTitle } from '../lib/note';
import { buildGraph } from '../lib/graph';
import { layoutFlat } from '../lib/flat-graph';
import { buildJournalBoard } from '../lib/journal-board';

const intro = readFileSync('src/data/home-intro.html', 'utf8');
const pieces = readFileSync('src/data/home-pieces.html', 'utf8');
const mind = readFileSync('src/data/home-mind.html', 'utf8');
const works = readFileSync('src/data/home-works.html', 'utf8');

const notes = await getCollection('notes');
const wiki = notes.filter((n) => n.id.startsWith('wiki/'));
const board = buildJournalBoard(notes);
const graph = layoutFlat(
  buildGraph(
    wiki.map((n) => ({
      slug: n.id,
      title: deriveTitle(n.data, n.id, n.body),
      type: typeof n.data.type === 'string' ? n.data.type : '',
      body: n.body ?? '',
      domain: typeof n.data.domain === 'string' ? n.data.domain : undefined,
    })),
  ),
  { width: 414, height: 124, limit: 44, labels: false },
);

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const newest = board.newest[0];
let updatedLabel = '';
if (newest) {
  const [y, m, d] = newest.date.split('-').map(Number);
  updatedLabel = `${d} ${months[m - 1]} ${y}`;
}

const dated = notes
  .map((n) => n.id.match(/^journal\/(\d{4}-\d{2}-\d{2})-/))
  .filter((m): m is RegExpMatchArray => Boolean(m))
  .map((m) => m[1]);
const weekKey = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  const date = new Date(Date.UTC(y, m - 1, d));
  const sunday = new Date(date);
  sunday.setUTCDate(date.getUTCDate() - date.getUTCDay());
  return sunday.toISOString().slice(0, 10);
};
const activeWeeks = new Set(dated.map(weekKey));
const today = new Date(Date.UTC(2026, 10, 28));
today.setUTCDate(today.getUTCDate() - today.getUTCDay());
const weeks: { on: boolean }[] = [];
for (let i = 25; i >= 0; i--) {
  const day = new Date(today);
  day.setUTCDate(today.getUTCDate() - i * 7);
  weeks.push({ on: activeWeeks.has(day.toISOString().slice(0, 10)) });
}
const activeCount = weeks.filter((w) => w.on).length;
---

<Base title="Logos52" description="A research database on learning hard things faster, with AI agents as the means." kind="home" section="home">
  <div class="page" id="page-home">
    <div class="top-block">
      <div class="intro-col">
        <header class="mast">
          <a class="wordmark" href="/">
            <svg class="mark-mast" xmlns="http://www.w3.org/2000/svg" viewBox="4 6 40 40" aria-hidden="true">
              <path d="M24 25 L11 25 M24 25 L31 38" stroke="#1a1a1a" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="24" cy="25" r="6.5" fill="#1a1a1a"></circle>
              <circle cx="11" cy="25" r="4" fill="#1a1a1a"></circle>
              <circle cx="31" cy="38" r="4" fill="#1a1a1a"></circle>
              <circle cx="38" cy="13" r="3.5" fill="#1a1a1a"></circle>
            </svg>
            Logos52
          </a>
        </header>
        <section id="intro" set:html={intro} />
      </div>
      <aside class="org now" aria-label="Now">
        <h6>Updated</h6>
        <p><time datetime={newest?.date ?? ''} data-from="journal">{updatedLabel}</time></p>
        <h6>Underway</h6>
        <p><a href="#work">Tsumugu</a></p>
      </aside>
      <div class="pieces-band" set:html={pieces} />
    </div>

    <div class="columns" aria-label="Home sections">
      <section class="col-narrow" id="work">
        <header class="col-head"><h1>Projects</h1></header>
        <div class="works" data-from="projects" set:html={works} />
      </section>

      <section class="col-narrow" id="journal" data-from="journal">
        <header class="col-head">
          <h1>Journal</h1>
          <svg class="weeks" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 117 10" width="117" height="10" role="img" aria-label={`Weeks with a journal entry: ${activeCount} of the last 26`}>
            <title>{`Weeks with a journal entry: ${activeCount} of the last 26`}</title>
            {
              weeks.map((week, i) => (
                <circle cx={2.2 + i * 4.5} cy="5" r="1.7" fill={week.on ? 'oklch(0.56 0.15 150)' : '#d4d4d4'} />
              ))
            }
          </svg>
        </header>
        <div class="journal">
          {
            board.newest.map((entry) => (
              <a href={entry.href}>
                <time datetime={entry.date}>
                  {`${Number(entry.date.slice(8, 10))} ${months[Number(entry.date.slice(5, 7)) - 1]} ${entry.date.slice(0, 4)}`}
                </time>
                <h3>{entry.title}</h3>
              </a>
            ))
          }
        </div>
        <p class="more"><a href="/journal/">All journal entries</a></p>
      </section>

      <section class="col-wide" id="explainers">
        <header class="col-head">
          <h1>Explainers</h1>
          <p class="kicker"><a href="/explainers/"><span data-count="explainers">{wiki.length}</span> pages</a></p>
        </header>
        <FlatGraph graph={graph} label={`The ${graph.nodes.length} most linked of ${wiki.length} wiki pages, as a graph coloured by section`} />
        <p class="more"><a href="/explainers/">All pages</a></p>
      </section>
    </div>

    <section class="mind-wide" aria-label="Top of mind">
      <header class="col-head" id="mind"><h1>Top of mind</h1></header>
      <div class="mind" set:html={mind} />
    </section>
  </div>
</Base>
