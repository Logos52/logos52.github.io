---
/**
 * index.astro — Logos52 home: objective, five problem doors, top of mind, omission line.
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { DOMAINS, DOMAIN_LABELS, DOMAIN_STANCES, type Domain } from '../lib/types';
import { DOMAIN_ICONS } from '../lib/icons';

const objective =
  'This wiki is compiled with agents, but the human still sets direction, judges what ships, and owns what the pages claim.';

const topOfMind: string[] = [
  'Whether story arcs need a moral core before the character risks losing something they love.',
  'How much of daily life still belongs on personal pages that stay off the public site.',
  'Where political arguments hold up when you trace them past the headline.',
];
if (topOfMind.length !== 3) throw new Error('Top of mind holds exactly 3 lines on the home page.');

const omitted =
  'Raw sources, private notes, financial detail, and workbench drafts stay out of the published wiki.';
---

<Base title="Logos52" description={objective} active="home">
  <main class="home">
    <div class="wrap">
      <section class="hero">
        <p class="hero__objective">{objective}</p>
      </section>

      <section class="doors" aria-labelledby="doors-head">
        <h2 id="doors-head" class="doors__head">Where to start</h2>
        <ul class="doors__list">
          {DOMAINS.map((d: Domain) => (
            <li>
              <a class="door" href={`/domains/${d}/`} style={`--dc:var(--d-${d})`}>
                <span class="door__label">
                  <Icon name={DOMAIN_ICONS[d]} size="16px" class="door__icon" />
                  {DOMAIN_LABELS[d]}
                </span>
                <span class="door__stance">{DOMAIN_STANCES[d]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="topmind" aria-labelledby="topmind-head">
        <h2 id="topmind-head" class="topmind__head">Top of mind</h2>
        <ul class="topmind__lines">
          {topOfMind.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </section>

      <p class="omit">{omitted}</p>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 48px 28px 56px;
  }
  .hero__objective {
    font-family: var(--ming);
    font-size: var(--kb-text-h2-shell);
    line-height: var(--kb-lh-snug);
    color: var(--ink);
    margin: 0;
    max-width: 40rem;
  }
  .doors {
    margin-top: 40px;
  }
  .doors__head,
  .topmind__head {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    font-weight: 600;
    margin: 0 0 14px;
    color: var(--ink);
  }
  .doors__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .door {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }
  .doors__list li:last-child .door {
    border-bottom: 1px solid var(--rule);
  }
  .door:hover .door__label {
    color: var(--accent);
  }
  .door__label {
    font-family: var(--ming);
    font-size: var(--kb-text-md);
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .door :global(.door__icon) {
    color: var(--dc);
    opacity: 0.85;
  }
  .door__stance {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    line-height: var(--kb-lh-body);
    color: var(--mut);
    max-width: 44rem;
  }
  .topmind {
    margin-top: 36px;
  }
  .topmind__lines {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .topmind__lines li {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    line-height: var(--kb-lh-body);
    color: var(--ink);
    max-width: 44rem;
  }
  .omit {
    margin: 36px 0 0;
    font-family: var(--ming);
    font-size: var(--kb-text-sm);
    color: var(--faint);
    max-width: 40rem;
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 36px 16px 48px;
    }
  }
</style>