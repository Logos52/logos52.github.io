---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deriveTitle, deriveSummary } from '../lib/note';
import { slugToUrl } from '../lib/slug';

const notes = (await getCollection('notes'))
  .filter((n) => n.id.startsWith('personal/') && n.id !== 'personal/index')
  .map((n) => ({
    title: deriveTitle(n.data, n.id, n.body),
    summary: deriveSummary(n.data, n.body ?? ''),
    href: slugToUrl(n.id),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Personal — Logos52" description="Personal notes." section="">
  <div class="page" id="page-explainers">
    <header class="mast"><span class="title">Personal</span></header>
    <p class="sum">Notes that sit beside the wiki.</p>
    {
      notes.map((n) => (
        <a class="rw" href={n.href}>
          <b>{n.title}</b>
          {n.summary && <span>{n.summary}</span>}
        </a>
      ))
    }
  </div>
</Base>
