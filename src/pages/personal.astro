---
/**
 * personal.astro — the Personal landing, in the home page's design family: hero (ming title +
 * mono lede), a local constellation over the personal neighborhood, the dated-notes changelog
 * (updates-box idiom), and the settled standing pages as a hub card.
 *
 * Door prose lives in the vault at personal/index.md (the only hand-written part; its
 * `description` is the hero lede). Notes = personal/*.md newest-first by `created`, blurb from
 * `description`; Settled = every `type: personal` page elsewhere in the vault, labeled and
 * hue-spread by wing. An empty Notes list renders nothing — no placeholder.
 */
import { getEntry, getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';
import Icon from '../components/Icon.astro';
import { deriveTitle } from '../lib/note';
import { simplifySlug, slugifyFilePath } from '../lib/slug';

const entry = await getEntry('notes', 'personal/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const lede = (entry?.data.description as string | undefined) ?? 'Working notes on mindset, habits, and judgment.';

const all = await getCollection('notes');

const toTime = (v: unknown): number => {
  if (!v) return 0;
  const d = new Date(String(v));
  return Number.isNaN(d.getTime()) ? 0 : d.getTime();
};
const fmtDate = (v: unknown): string => {
  const t = toTime(v);
  return t === 0 ? '' : new Date(t).toISOString().slice(0, 10);
};

// A personal/ page carrying `status: standing` is not a dated position — it keeps being updated
// rather than superseded by a newer note — so it leaves the changelog and joins the standing band.
const isStanding = (e: (typeof all)[number]) => String(e.data.status ?? '') === 'standing';
const inSection = (e: (typeof all)[number]) => e.id.startsWith('personal/') && e.id !== 'personal/index';

const notes = all
  .filter((e) => inSection(e) && !isStanding(e))
  .sort((a, b) => toTime(b.data.created) - toTime(a.data.created));

const settled = all
  .filter((e) => e.data.type === 'personal' && (!e.id.startsWith('personal/') || isStanding(e)))
  // The section's own standing pages lead; the wing pages follow alphabetically.
  .sort((a, b) => {
    const rank = (e: (typeof all)[number]) => (inSection(e) ? 0 : 1);
    return (
      rank(a) - rank(b) || deriveTitle(a.data, a.id, a.body).localeCompare(deriveTitle(b.data, b.id, b.body))
    );
  });

// Wing (the folder a settled page lives in) → row label, icon, and a domain hue spread for
// rhythm, the way the home hub lists spread the palette. A standing page in the section itself
// has no wing folder, so it takes the "life" row.
const wingOf = (id: string): string => (id.startsWith('personal/') ? 'life' : (id.split('/')[1] ?? '').toLowerCase());
const WING_ICONS: Record<string, string> = { life: 'ti-user', fitness: 'ti-heartbeat', fashion: 'ti-hanger', travel: 'ti-plane' };
const WING_COLORS: Record<string, string> = { life: 'var(--d-mind)', fitness: 'var(--d-focus)', fashion: 'var(--d-gen)', travel: 'var(--d-language)' };

// The personal neighborhood: every settled page + every note, 1 hop into the rest of the vault.
const seeds = [...settled, ...notes].map((e) => e.id);

// "Practicing" — the deliberate practices currently running, owned in personal/index.md
// frontmatter (`practicing:` — list of { text, page? }); a set page links the line to it.
type Practice = { text: string; page?: string };
type Link = { text: string; page?: string; href?: string };
const fmList = (key: string): Link[] => {
  const v = (entry?.data as Record<string, unknown> | undefined)?.[key];
  return Array.isArray(v) ? (v as Link[]).filter((x) => x && x.text) : [];
};
const positions = fmList('positions');
const elsewhere = fmList('elsewhere');
// "Uses this" — grouped inventory from frontmatter (`uses: { carry: [...], desk: [...] }`).
// A group with nothing in it renders nothing; no placeholders.
const usesRaw = ((entry?.data as Record<string, unknown> | undefined)?.uses ?? {}) as Record<string, string[]>;
const uses = Object.entries(usesRaw)
  .filter(([, items]) => Array.isArray(items) && items.length > 0)
  .map(([group, items]) => ({ group, items }));
const linkHref = (l: Link) => l.href ?? '/' + simplifySlug(slugifyFilePath(l.page ?? ''));
const practicing: Practice[] = Array.isArray((entry?.data as Record<string, unknown> | undefined)?.practicing)
  ? ((entry!.data as Record<string, unknown>).practicing as Practice[]).filter((p) => p && p.text)
  : [];
---

<Base title="Personal" description={lede} active="personal">
  <main class="personal">
    <div class="wrap">
      <section class="top">
        <div class="top__lead">
          <h1 class="hero__title">Personal</h1>
          {Content && (
            <div class="contract kb-shell-prose">
              <Content />
            </div>
          )}
        </div>
      </section>

      {
        positions.length > 0 && (
          <section class="band band--bare">
            <ul class="doors">
              {positions.map((l) => (
                <li>
                  <a class="door" href={linkHref(l)}>{l.text}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        practicing.length > 0 && (
          <section class="mind">
            <h2 class="sec-head">Practicing</h2>
            <ul class="mind__list">
              {practicing.map((p) => (
                <li class="mind__q">
                  {p.page ? <a class="mind__link" href={'/' + simplifySlug(slugifyFilePath(p.page))}>{p.text}</a> : p.text}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        uses.length > 0 && (
          <section class="band">
            <h2 class="sec-head">{uses.length > 1 ? 'Uses this' : uses[0].group.charAt(0).toUpperCase() + uses[0].group.slice(1)}</h2>
            {uses.map((g) => (
              <div class="uses__group">
                {uses.length > 1 && <h3 class="uses__label">{g.group}</h3>}
                <ul class="uses__list">
                  {g.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        )
      }

      {
        notes.length > 0 && (
          <section class="notes">
            <h2 class="sec-head">Notes</h2>
            <div class="notes__box">
              {notes.map((e) => (
                <div class="notes__item">
                  <div class="notes__date">{fmtDate(e.data.created)}</div>
                  <a class="notes__title" href={'/' + simplifySlug(e.id)}>
                    {deriveTitle(e.data, e.id, e.body)}
                  </a>
                  {e.data.description && <p class="notes__blurb">{e.data.description}</p>}
                </div>
              ))}
            </div>
          </section>
        )
      }

      <section class="settled">
        <h2 class="sec-head">Standing pages</h2>
        <div class="settled__cards">
          {settled.map((e) => (
            <a class="scard" style={`--dc:${WING_COLORS[wingOf(e.id)] ?? 'var(--d-mind)'}`} href={'/' + simplifySlug(e.id)}>
              <span class="scard__kind">
                <Icon name={WING_ICONS[wingOf(e.id)] ?? 'ti-notes'} size="13px" />
                <span class="scard__wing">{wingOf(e.id)}</span>
              </span>
              <span class="scard__title">{deriveTitle(e.data, e.id, e.body)}</span>
              {e.data.blurb && <span class="scard__sub">{e.data.blurb}</span>}
            </a>
          ))}
        </div>
      </section>

      {
        elsewhere.length > 0 && (
          <section class="band">
            <h2 class="sec-head">Elsewhere</h2>
            <ul class="doors">
              {elsewhere.map((l) => (
                <li>
                  <a class="door" href={linkHref(l)}>{l.text}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="minimap">
        <Constellation mode="local" seeds={seeds} hops={1} nodeScale={0.55} labels="hover" height="clamp(180px, 26vh, 260px)" />
      </section>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 0 28px;
  }
  .personal {
    padding-bottom: 40px;
  }

  .top {
    padding: 40px 0 0;
  }
  .top__lead {
    min-width: 0;
  }
  /* The local graph closes the page rather than sitting beside the hero: it is a way out
     once a reader has finished, not something competing with the first paragraph. */
  .minimap {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .hero__title {
    font-family: var(--ming);
    font-weight: 500;
    font-size: var(--kb-text-h1-shell);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .contract {
    max-width: 60ch;
    margin-top: 14px;
  }
  .contract :global(p) {
    font-size: var(--kb-text-base);
    line-height: var(--kb-lh-body);
    color: var(--ink);
    margin: 0;
  }
  /* The door photo floats into the lede the way the About portrait does, so the prose wraps it
     rather than sitting under a banner. Cleared below so the section headers start flush. */
  .contract :global(img) {
    float: right;
    width: 40%;
    max-width: 210px;
    height: auto;
    border-radius: 12px;
    margin: 0.3rem 0 0.5rem 1.4rem;
  }
  .contract :global(p:has(img)) {
    margin: 0;
  }
  .contract::after {
    content: '';
    display: table;
    clear: both;
  }

  /* The record: fenced above and below so it reads as a record rather than as the door's
     second paragraph. Separation without a label, since a heading over it would have to name
     the owner's relationship to himself. */
  .contract :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 14px 0;
  }

  .band {
    margin-top: 26px;
  }
  .band--bare {
    margin-top: 14px;
  }
  .doors {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .door {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    color: var(--accent);
    text-decoration: none;
  }
  .door:hover {
    text-decoration: underline;
  }
  .uses__group + .uses__group {
    margin-top: 12px;
  }
  .uses__label {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 4px;
    font-weight: 500;
  }
  .uses__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .uses__list li {
    font-size: var(--kb-text-sm);
    color: var(--mut);
    line-height: var(--kb-lh-snug);
  }

  .sec-head {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--ink);
  }

  .notes {
    margin-top: 26px;
  }
  .notes__box {
    background: var(--card);
    border: 1px solid var(--rule);
    border-radius: var(--tsg-radius);
    padding: 4px 16px;
    box-shadow: var(--tsg-shadow);
  }
  .notes__item {
    padding: 12px 0;
  }
  .notes__item + .notes__item {
    border-top: 1px solid var(--rule);
  }
  .notes__date {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--faint);
    margin: 0 0 4px;
  }
  .notes__title {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    font-weight: 600;
    line-height: 1.25;
    color: var(--accent);
    text-decoration: none;
  }
  .notes__title:hover {
    text-decoration: underline;
  }
  .notes__blurb {
    font-size: var(--kb-text-sm);
    color: var(--mut);
    line-height: var(--kb-lh-body);
    margin: 3px 0 0;
  }

  .mind {
    margin-top: 26px;
  }
  .mind__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .mind__q {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    color: var(--ink);
  }
  .mind__link {
    color: inherit;
    text-decoration: none;
  }
  .mind__link:hover {
    color: var(--accent);
  }

  .settled {
    margin-top: 26px;
  }
  .settled__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .scard {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 15px;
    border-radius: var(--tsg-radius);
    border: 1px solid color-mix(in oklab, var(--dc) 22%, var(--rule));
    background: color-mix(in oklab, var(--dc) 6%, var(--card));
    box-shadow: var(--tsg-shadow);
    text-decoration: none;
    transition:
      transform var(--dur-fast),
      border-color var(--dur-base);
  }
  .scard:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--dc) 40%, var(--rule));
  }
  .scard__kind {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .scard__kind :global(.kb-icon) {
    color: var(--dc);
    opacity: 0.7;
  }
  .scard__wing {
    font-family: var(--mono);
    font-size: 8.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dc);
  }
  .scard__title {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }
  .scard__sub {
    font-size: var(--kb-text-sm);
    color: var(--mut);
    line-height: var(--kb-lh-snug);
  }

  @media (max-width: 820px) {
    .settled__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .settled__cards {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 0 16px;
    }
  }
</style>
