---
/**
 * personal.astro — Personal landing. Off the menu. The graph stays on Map.
 */
import { getEntry, getCollection, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import { deriveTitle } from '../lib/note';
import { simplifySlug, slugifyFilePath } from '../lib/slug';

const entry = await getEntry('notes', 'personal/index');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const lede = (entry?.data.description as string | undefined) ?? 'Working notes on mindset, habits, and judgment.';

const all = await getCollection('notes');

const toTime = (v: unknown): number => {
  if (!v) return 0;
  const d = new Date(String(v));
  return Number.isNaN(d.getTime()) ? 0 : d.getTime();
};
const fmtDate = (v: unknown): string => {
  const t = toTime(v);
  return t === 0 ? '' : new Date(t).toISOString().slice(0, 10);
};

const isStanding = (e: (typeof all)[number]) => String(e.data.status ?? '') === 'standing';
const inSection = (e: (typeof all)[number]) => e.id.startsWith('personal/') && e.id !== 'personal/index';

const notes = all
  .filter((e) => inSection(e) && !isStanding(e))
  .sort((a, b) => toTime(b.data.created) - toTime(a.data.created));

const settled = all
  .filter((e) => e.data.type === 'personal' && (!e.id.startsWith('personal/') || isStanding(e)))
  .sort((a, b) => {
    const rank = (e: (typeof all)[number]) => (inSection(e) ? 0 : 1);
    return rank(a) - rank(b) || deriveTitle(a.data, a.id, a.body).localeCompare(deriveTitle(b.data, b.id, b.body));
  });

const wingOf = (id: string): string => (id.startsWith('personal/') ? 'life' : (id.split('/')[1] ?? '').toLowerCase());

type Practice = { text: string; page?: string };
type Link = { text: string; page?: string; href?: string };
const fmList = (key: string): Link[] => {
  const v = (entry?.data as Record<string, unknown> | undefined)?.[key];
  return Array.isArray(v) ? (v as Link[]).filter((x) => x && x.text) : [];
};
const positions = fmList('positions');
const elsewhere = fmList('elsewhere');
const usesRaw = ((entry?.data as Record<string, unknown> | undefined)?.uses ?? {}) as Record<string, string[]>;
const uses = Object.entries(usesRaw)
  .filter(([, items]) => Array.isArray(items) && items.length > 0)
  .map(([group, items]) => ({ group, items }));
const linkHref = (l: Link) => l.href ?? '/' + simplifySlug(slugifyFilePath(l.page ?? ''));
const practicing: Practice[] = Array.isArray((entry?.data as Record<string, unknown> | undefined)?.practicing)
  ? ((entry!.data as Record<string, unknown>).practicing as Practice[]).filter((p) => p && p.text)
  : [];
---

<Shell title="Personal" description={lede}>
  <main class="page">
    <h1 class="page__title">Personal</h1>
    {Content && (
      <div class="copy">
        <Content />
      </div>
    )}

    {
      positions.length > 0 && (
        <section class="band">
          <ul class="word">
            {positions.map((l) => (
              <li>
                <a class="word__link" href={linkHref(l)}>
                  <span class="word__title">{l.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      practicing.length > 0 && (
        <section class="band">
          <h2 class="band__title">Practicing</h2>
          <ul class="word">
            {practicing.map((p) => (
              <li>
                {p.page ? (
                  <a class="word__link" href={'/' + simplifySlug(slugifyFilePath(p.page))}>
                    <span class="word__title">{p.text}</span>
                  </a>
                ) : (
                  <span class="word__title">{p.text}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      uses.length > 0 && (
        <section class="band">
          <h2 class="band__title">{uses.length > 1 ? 'Uses this' : uses[0].group.charAt(0).toUpperCase() + uses[0].group.slice(1)}</h2>
          {uses.map((g) => (
            <div>
              {uses.length > 1 && <h3 class="band__title">{g.group}</h3>}
              <ul class="lines">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      notes.length > 0 && (
        <section class="band">
          <h2 class="band__title">Notes</h2>
          <ul class="word">
            {notes.map((e) => (
              <li>
                <a class="word__link" href={'/' + simplifySlug(e.id)}>
                  <span class="word__title">{deriveTitle(e.data, e.id, e.body)}</span>
                  <span class="word__meta">{[fmtDate(e.data.created), e.data.description].filter(Boolean).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="band">
      <h2 class="band__title">Standing pages</h2>
      <ul class="word">
        {
          settled.map((e) => (
            <li>
              <a class="word__link" href={'/' + simplifySlug(e.id)}>
                <span class="word__title">{deriveTitle(e.data, e.id, e.body)}</span>
                <span class="word__meta">{[wingOf(e.id), e.data.blurb].filter(Boolean).join(' · ')}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      elsewhere.length > 0 && (
        <section class="band">
          <h2 class="band__title">Elsewhere</h2>
          <ul class="word">
            {elsewhere.map((l) => (
              <li>
                <a class="word__link" href={linkHref(l)}>
                  <span class="word__title">{l.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Shell>
