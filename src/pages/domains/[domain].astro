---
/**
 * domains/[domain].astro — per-domain Map of Content. The page list for one domain.
 * Reached from a domain chip on the home page or a domain heading on the Map.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { deriveTitle, deriveSummary } from '../../lib/note';
import { resolveDomain } from '../../lib/domain';
import { simplifySlug, slugToUrl } from '../../lib/slug';
import { DOMAINS, DOMAIN_LABELS, type Domain } from '../../lib/types';
import { DOMAIN_ICONS } from '../../lib/icons';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d } }));
}
const { domain } = Astro.params as { domain: Domain };
const label = DOMAIN_LABELS[domain] ?? domain;

const pages = (await getCollection('notes'))
  .filter((n) => simplifySlug(n.id) !== '/' && resolveDomain(n.id, n.data.domain) === domain)
  .map((n) => ({
    slug: n.id,
    title: deriveTitle(n.data, n.id, n.body),
    summary: deriveSummary(n.data, n.body),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title={`${label} — Map of Content`} description={`Every ${label} note.`} active="notes">
  <main class="domain-page">
    <div class="wrap">
      <div class="main">
        <header class="head">
          <a class="head__kind" href="/map/" style={`color:var(--d-${domain})`}>Map of Content</a>
          <h1>
            <Icon name={DOMAIN_ICONS[domain]} size="0.92em" class="head__icon" style={`color:var(--d-${domain})`} />
            {label}
          </h1>
          <p>{pages.length} notes</p>
        </header>

        <ul class="moc">
          {pages.map((p) => (
            <li>
              <a href={slugToUrl(p.slug)}>
                <span class="moc__title">{p.title}</span>
                {p.summary && <span class="moc__sub">{p.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 32px 28px 52px;
  }
  .main {
    min-width: 0;
  }
  .head {
    margin-bottom: 16px;
  }
  .head__kind {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .head__kind:hover {
    text-decoration: underline;
  }
  .head h1 {
    font-family: var(--ming);
    font-size: 1.8rem;
    font-weight: 500;
    margin: 5px 0 2px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .head h1 :global(.head__icon) {
    flex-shrink: 0;
  }
  .head p {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
  }
  .moc {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .moc li {
    border-top: 1px solid var(--rule);
  }
  .moc li:first-child {
    border-top: none;
  }
  .moc a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 2px;
    text-decoration: none;
  }
  .moc a:hover .moc__title {
    color: var(--accent);
  }
  .moc__title {
    font-family: var(--ming);
    font-size: 14px;
    color: var(--ink);
  }
  .moc__sub {
    font-size: 12px;
    color: var(--mut);
    line-height: 1.45;
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 26px 16px 40px;
    }
  }
</style>
