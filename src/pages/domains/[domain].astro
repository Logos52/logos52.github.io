---
/**
 * domains/[domain].astro — per-domain Map of Content. Journal-style spread: the page list on the
 * left (2/3) and the domain's sub-graph as a vertical constellation on the right (1/3). Reached by
 * clicking a legend chip on the home graph.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Constellation from '../../components/Constellation.astro';
import { deriveTitle, deriveSummary } from '../../lib/note';
import { resolveDomain } from '../../lib/domain';
import { simplifySlug, slugToUrl } from '../../lib/slug';
import { DOMAINS, DOMAIN_LABELS, type Domain } from '../../lib/types';
import { DOMAIN_ICONS } from '../../lib/icons';

export function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d } }));
}
const { domain } = Astro.params as { domain: Domain };
const label = DOMAIN_LABELS[domain] ?? domain;

const pages = (await getCollection('notes'))
  .filter((n) => simplifySlug(n.id) !== '/' && resolveDomain(n.id) === domain)
  .map((n) => ({
    slug: n.id,
    title: deriveTitle(n.data, n.id, n.body),
    summary: deriveSummary(n.data, n.body),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title={`${label} — Map of Content`} description={`Every ${label} note, with the domain sub-graph.`} active="notes">
  <main class="domain-page">
    <div class="wrap domain-grid">
      <div class="main">
        <header class="head">
          <a class="head__kind" href="/map/" style={`color:var(--d-${domain})`}>Map of Content</a>
          <h1>
            <i
              class={`ti ${DOMAIN_ICONS[domain]} head__icon`}
              style={`color:var(--d-${domain})`}
              aria-hidden="true"
            />
            {label}
          </h1>
          <p>{pages.length} notes</p>
        </header>

        <ul class="moc">
          {pages.map((p) => (
            <li>
              <a href={slugToUrl(p.slug)}>
                <span class="moc__title">{p.title}</span>
                {p.summary && <span class="moc__sub">{p.summary}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="side" aria-hidden="true">
        <Constellation mode="full" domain={domain} orient="vertical" height="clamp(360px, 70vh, 640px)" />
      </aside>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 32px 28px 52px;
  }
  .domain-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 36px;
    align-items: start;
  }
  .main {
    min-width: 0;
  }
  .side {
    position: sticky;
    top: 80px;
    min-width: 0;
  }
  .side__head {
    font-family: var(--ming);
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 10px;
    color: var(--ink);
  }
  .head {
    margin-bottom: 16px;
  }
  .head__kind {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .head__kind:hover {
    text-decoration: underline;
  }
  .head h1 {
    font-family: var(--ming);
    font-size: 1.8rem;
    font-weight: 500;
    margin: 5px 0 2px;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .head__icon {
    font-size: 0.92em;
    line-height: 1;
    flex-shrink: 0;
  }
  .head p {
    margin: 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
  }
  .moc {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .moc li {
    border-top: 1px solid var(--rule);
  }
  .moc li:first-child {
    border-top: none;
  }
  .moc a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 2px;
    text-decoration: none;
  }
  .moc a:hover .moc__title {
    color: var(--accent);
  }
  .moc__title {
    font-family: var(--ming);
    font-size: 14px;
    color: var(--ink);
  }
  .moc__sub {
    font-size: 12px;
    color: var(--mut);
    line-height: 1.45;
  }
  @media (max-width: 820px) {
    .domain-grid {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      order: -1; /* graph above the list on narrow screens */
    }
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 26px 16px 40px;
    }
  }
</style>
