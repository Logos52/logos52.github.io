---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import { deriveTitle, deriveSummary } from '../../lib/note';
import { resolveDomain } from '../../lib/domain';
import { simplifySlug, slugToUrl } from '../../lib/slug';
import { DOMAINS, DOMAIN_LABELS, type Domain } from '../../lib/types';

export function getStaticPaths() {
  return DOMAINS.map((d) => ({ params: { domain: d } }));
}
const { domain } = Astro.params as { domain: Domain };
const label = DOMAIN_LABELS[domain] ?? domain;

const pages = (await getCollection('notes'))
  .filter((n) => simplifySlug(n.id) !== '/' && resolveDomain(n.id, n.data.domain) === domain)
  .map((n) => ({
    slug: n.id,
    title: deriveTitle(n.data, n.id, n.body),
    summary: deriveSummary(n.data, n.body),
  }))
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Shell title={label} description={`Every ${label} note.`} active="map">
  <main class="page">
    <header>
      <p class="trail"><a href="/map/">Map of Content</a></p>
      <h1 class="page__title">{label}</h1>
      <p class="page__dek">{pages.length} notes</p>
    </header>
    <ul class="word">
      {
        pages.map((p) => (
          <li>
            <a class="word__link" href={slugToUrl(p.slug)}>
              <span class="word__title">{p.title}</span>
              {p.summary && <span class="word__meta">{p.summary}</span>}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Shell>
