---
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return ['learning', 'agentic', 'language', 'focus', 'mind', 'gen', 'ai', 'self', 'world', 'craft'].map((domain) => ({
    params: { domain },
  }));
}) satisfies GetStaticPaths;

return Astro.redirect('/explainers/', 301);
---
