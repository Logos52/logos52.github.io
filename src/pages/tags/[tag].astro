---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Shell from '../../layouts/Shell.astro';
import { deriveTitle, deriveSummary, readerTypeLabel } from '../../lib/note';
import { resolveDomain } from '../../lib/domain';
import { simplifySlug, slugToUrl } from '../../lib/slug';

export const getStaticPaths = (async () => {
  const sensitive = new Set([
    'finances',
    'budget',
    'private',
    'secret',
    'secrets',
    'salary',
    'networth',
  ]);
  const notes = await getCollection('notes');
  const tags = new Map<string, typeof notes>();
  for (const n of notes) {
    if (simplifySlug(n.id) === '/') continue;
    const list = Array.isArray(n.data.tags) ? n.data.tags : [];
    for (const tag of list) {
      const key = String(tag).trim().toLowerCase();
      if (!key || sensitive.has(key)) continue;
      const bucket = tags.get(key) ?? [];
      bucket.push(n);
      tags.set(key, bucket);
    }
  }
  return [...tags.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: {
      tag,
      entries: entries
        .map((n) => ({
          slug: n.id,
          title: deriveTitle(n.data, n.id, n.body),
          summary: deriveSummary(n.data, n.body),
          domain: resolveDomain(n.id, n.data.domain),
          kind: readerTypeLabel(n.data.type) ?? 'Note',
        }))
        .sort((a, b) => a.title.localeCompare(b.title)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, entries } = Astro.props as {
  tag: string;
  entries: { slug: string; title: string; summary: string; domain: string; kind: string }[];
};
---

<Shell title={`#${tag}`} description={`Notes tagged ${tag}.`}>
  <main class="page">
    <header>
      <h1 class="page__title">#{tag}</h1>
      <p class="page__dek">{entries.length} note{entries.length === 1 ? '' : 's'}</p>
    </header>
    <ul class="word">
      {
        entries.map((n) => (
          <li>
            <a class="word__link" href={slugToUrl(n.slug)}>
              <span class="word__title">{n.title}</span>
              <span class="word__meta">{n.kind}{n.summary ? ` · ${n.summary}` : ''}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Shell>
