---
/**
 * about.astro — the About page, rendered as a clean compact prose page (matches Notes/Journal).
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const entry = await getEntry('notes', 'about');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<Base title="About" description="About Logos52 and this knowledge base." active="about">
  <main class="about-page">
    <article class="kb-shell-prose about-prose wrap">
      {Content ? <Content /> : <p>About not found.</p>}
    </article>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 34px 28px 52px;
  }
  .about-prose :global(img) {
    float: left;
    width: 33%;
    height: auto;
    border-radius: 12px;
    margin: 0.4rem 1.5rem 0.6rem 0;
  }
  .about-prose::after {
    content: '';
    display: table;
    clear: both;
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
    .about-prose :global(img) {
      float: none;
      width: 55%;
      margin: 0.6rem 0 1rem;
    }
  }
</style>