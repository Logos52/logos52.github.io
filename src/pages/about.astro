---
import { getEntry, render } from 'astro:content';
import Shell from '../layouts/Shell.astro';

const entry = await getEntry('notes', 'about');
const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<Shell title="About" description="About Logos52 and this knowledge base." active="about">
  <main class="reading">
    <article class="copy">
      {Content ? <Content /> : <p>About not found.</p>}
    </article>
  </main>
</Shell>
