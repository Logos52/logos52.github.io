---
/**
 * map.astro — one Map page: full link graph on top, filterable searchable list below.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';
import { resolveDomain } from '../lib/domain';
import { deriveFirstImage, deriveSourceLine, deriveTitle } from '../lib/note';
import { slugToUrl } from '../lib/slug';
import { DOMAINS, DOMAIN_LABELS, type Domain } from '../lib/types';

const notes = await getCollection('notes');
const rows = notes
  .filter((n) => n.id.startsWith('wiki/') && !n.data.draft)
  .map((n) => {
    const domain = resolveDomain(n.id, n.data.domain) as Domain;
    const thumb = deriveFirstImage(n.body ?? '');
    return {
      slug: n.id,
      title: deriveTitle(n.data, n.id, n.body),
      url: slugToUrl(n.id),
      source: deriveSourceLine(n.id),
      domain,
      ...(thumb ? { thumb } : {}),
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const rowsJson = JSON.stringify(rows);
---

<Base title="Map" description="The vault graph and every wiki page." active="map">
  <main class="map-page">
    <div class="wrap map-graph">
      <header class="map-head">
        <h1 class="map-head__title">Map</h1>
      </header>
      <Constellation mode="full" domainLabels height="clamp(400px, 58vh, 680px)" />
    </div>

    <section class="map-list-wrap wrap" data-map-root>
      <div class="map-list-tools">
        <input
          type="search"
          class="map-list-search"
          data-map-search
          placeholder="Filter pages…"
          aria-label="Filter pages"
          autocomplete="off"
        />
        <div class="map-list-chips" role="group" aria-label="Filter by domain">
          {DOMAINS.map((d) => (
            <button type="button" class="map-list-chip" data-map-domain={d} style={`--chip:${`var(--d-${d})`}`}>
              {DOMAIN_LABELS[d]}
            </button>
          ))}
        </div>
      </div>
      <p class="map-list-empty" data-map-empty hidden>No pages match.</p>
      <ul class="map-list" data-map-list></ul>
      <script type="application/json" id="map-rows-data" set:html={rowsJson} />
    </section>
  </main>
</Base>

<script>
  import { initMapList, type MapRow } from '../islands/map-list';

  const root = document.querySelector('[data-map-root]');
  const dataEl = document.getElementById('map-rows-data');
  if (root && dataEl?.textContent) {
    const rows = JSON.parse(dataEl.textContent) as MapRow[];
    initMapList(root as HTMLElement, rows);
  }
</script>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 0 28px;
  }
  .map-graph {
    padding-top: 28px;
  }
  .map-head {
    margin: 0 0 12px;
  }
  .map-head__title {
    font-family: var(--ming);
    font-weight: 500;
    font-size: var(--kb-text-h1-shell);
    line-height: var(--kb-lh-tight);
    margin: 0;
    color: var(--ink);
  }
  .map-list-wrap {
    padding: 36px 28px 64px;
    border-top: 1px solid var(--rule);
    margin-top: 8px;
  }
  .map-list-tools {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 20px;
  }
  .map-list-search {
    font-family: var(--sans);
    font-size: var(--kb-text-base);
    width: 100%;
    max-width: 28rem;
    border: 1px solid var(--rule2);
    border-radius: 4px;
    padding: 10px 12px;
    background: var(--card);
    color: var(--ink);
  }
  .map-list-search:focus {
    outline: none;
    border-color: var(--accent);
  }
  .map-list-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .map-list-chip {
    font-family: var(--sans);
    font-size: var(--kb-text-sm);
    color: var(--mut);
    background: transparent;
    border: 1px solid var(--rule2);
    border-radius: 999px;
    padding: 5px 12px;
    cursor: pointer;
  }
  .map-list-chip.on {
    color: var(--chip, var(--accent));
    border-color: var(--chip, var(--accent));
    background: color-mix(in oklab, var(--chip, var(--accent)) 10%, transparent);
  }
  .map-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .map-list :global(.map-row) {
    border-top: 1px solid var(--rule);
  }
  .map-list :global(.map-row__link) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 4px;
    text-decoration: none;
    color: inherit;
  }
  .map-list :global(.map-row__link:hover .map-row__title) {
    color: var(--accent);
  }
  .map-list :global(.map-row__thumb) {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .map-list :global(.map-row__text) {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .map-list :global(.map-row__title) {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    color: var(--ink);
  }
  .map-list :global(.map-row__source) {
    font-family: var(--sans);
    font-size: var(--kb-text-sm);
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .map-list-empty {
    font-size: var(--kb-text-sm);
    color: var(--faint);
    margin: 0 0 12px;
  }
  @media (max-width: 640px) {
    .wrap,
    .map-list-wrap {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>