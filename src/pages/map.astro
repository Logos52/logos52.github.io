---
import { getCollection } from 'astro:content';
import Shell from '../layouts/Shell.astro';
import Constellation from '../components/Constellation.astro';
import { resolveDomain } from '../lib/domain';
import { deriveFirstImage, deriveSourceLine, deriveTitle } from '../lib/note';
import { simplifySlug, slugToUrl } from '../lib/slug';
import { DOMAINS, DOMAIN_LABELS, type Domain } from '../lib/types';

const notes = await getCollection('notes');
const rows = notes
  .filter((n) => n.id.startsWith('wiki/') && !n.data.draft)
  .map((n) => {
    const domain = resolveDomain(n.id, n.data.domain) as Domain;
    const thumb = deriveFirstImage(n.body ?? '');
    return {
      slug: n.id,
      title: deriveTitle(n.data, n.id, n.body),
      url: slugToUrl(n.id),
      source: deriveSourceLine(n.id),
      domain,
      ...(thumb ? { thumb } : {}),
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const rowsJson = JSON.stringify(rows);

// Notes the site actually emits as pages. Root index is the custom home page.
// notes/index is the /notes/ redirect to this map. Every other collection entry
// is a page, including notes with no type.
function folderLabel(segment: string): string {
  return segment.replace(/--and--/g, ' & ').replace(/-+/g, ' ');
}

function sectionOf(id: string): { key: string; label: string } {
  const parts = id.split('/').filter(Boolean);
  parts.pop();
  if (parts.length === 0) return { key: '', label: 'Top level' };
  return { key: parts.join('/'), label: parts.map(folderLabel).join(' / ') };
}

const OTHER = 'Other';

type ContentPage = { title: string; url: string };
type SectionGroup = { label: string; count: number; pages: ContentPage[] };
type TypeGroup = { label: string; count: number; sections: SectionGroup[] };

const contentPages = notes.filter((n) => simplifySlug(n.id) !== '/' && n.id !== 'notes/index');
const buckets = new Map<string, Map<string, { label: string; pages: ContentPage[] }>>();

for (const n of contentPages) {
  const raw = typeof n.data.type === 'string' ? n.data.type.trim() : '';
  const typeLabel = raw || OTHER;
  const section = sectionOf(n.id);
  let sections = buckets.get(typeLabel);
  if (!sections) {
    sections = new Map();
    buckets.set(typeLabel, sections);
  }
  let group = sections.get(section.key);
  if (!group) {
    group = { label: section.label, pages: [] };
    sections.set(section.key, group);
  }
  group.pages.push({
    title: deriveTitle(n.data, n.id, n.body),
    url: slugToUrl(n.id),
  });
}

function byCountThenName<T extends { count: number; label: string }>(a: T, b: T): number {
  return b.count - a.count || a.label.localeCompare(b.label, 'en');
}

const typeGroups: TypeGroup[] = [];
for (const [label, sections] of buckets) {
  const sectionGroups: SectionGroup[] = [];
  for (const group of sections.values()) {
    group.pages.sort((a, b) => a.title.localeCompare(b.title, 'en') || a.url.localeCompare(b.url));
    sectionGroups.push({ label: group.label, count: group.pages.length, pages: group.pages });
  }
  sectionGroups.sort(byCountThenName);
  const count = sectionGroups.reduce((sum, group) => sum + group.count, 0);
  typeGroups.push({ label, count, sections: sectionGroups });
}

const otherGroups = typeGroups.filter((group) => group.label === OTHER);
const contentMap = [
  ...typeGroups.filter((group) => group.label !== OTHER).sort(byCountThenName),
  ...otherGroups,
];
const contentMapCount = contentMap.reduce((sum, group) => sum + group.count, 0);
const otherCount = otherGroups.reduce((sum, group) => sum + group.count, 0);
if (contentMapCount !== contentPages.length) {
  throw new Error(`Content map lists ${contentMapCount} pages; the site builds ${contentPages.length} note pages.`);
}

const contentMapDek =
  otherCount > 0
    ? `${contentMapCount} pages. ${otherCount} with no type.`
    : `${contentMapCount} pages.`;
---

<Shell title="Map" description="The vault graph and every wiki page." active="map">
  <main class="page">
    <header>
      <h1 class="page__title" data-map-title>Map</h1>
    </header>
    <Constellation mode="full" domainLabels height="clamp(400px, 58vh, 680px)" />

    <section data-map-root>
      <div class="filters">
        <input
          type="search"
          class="filters__input"
          data-map-search
          placeholder="Filter pages"
          aria-label="Filter pages"
          autocomplete="off"
        />
        <div class="filters__group" role="group" aria-label="Filter by domain">
          {
            DOMAINS.map((d) => (
              <button type="button" class="chip" data-map-domain={d}>
                {DOMAIN_LABELS[d]}
              </button>
            ))
          }
        </div>
      </div>
      <p class="word__empty" data-map-empty hidden>No pages match.</p>
      <ul class="word" data-map-list></ul>
      <script type="application/json" id="map-rows-data" set:html={rowsJson} />
    </section>

    <section
      class="band cmap"
      data-content-map
      data-content-map-count={contentMapCount}
      data-content-map-other={otherCount}
      data-pagefind-ignore
      aria-labelledby="content-map-title"
    >
      <h2 id="content-map-title" class="band__title">Content map</h2>
      <p class="page__dek">{contentMapDek}</p>
      <div class="cmap__tree">
        {
          contentMap.map((type) => (
            <details class="cmap__type">
              <summary>
                {type.label}
                <span class="cmap__n">
                  {type.count} {type.count === 1 ? 'page' : 'pages'}
                </span>
              </summary>
              {type.sections.map((section) => (
                <details class="cmap__section">
                  <summary>
                    {section.label}
                    <span class="cmap__n">
                      {section.count} {section.count === 1 ? 'page' : 'pages'}
                    </span>
                  </summary>
                  <ul class="cmap__pages">
                    {section.pages.map((page) => (
                      <li>
                        <a class="cmap__link" href={page.url}>
                          {page.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </details>
          ))
        }
      </div>
    </section>
  </main>
</Shell>

<script>
  import { initMapList } from '../islands/map-list';

  const root = document.querySelector('[data-map-root]');
  const dataEl = document.getElementById('map-rows-data');
  if (root && dataEl?.textContent) {
    const rows = JSON.parse(dataEl.textContent) as Parameters<typeof initMapList>[1];
    initMapList(root as HTMLElement, rows);
  }
</script>
