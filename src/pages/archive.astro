---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deriveSourceLine, deriveTitle } from '../lib/note';
import { slugToUrl } from '../lib/slug';

type ArchiveKind = 'past' | 'parked';

function archiveKind(status: unknown): ArchiveKind | null {
  const s = String(status ?? '').toLowerCase();
  if (s.startsWith('past') || s.includes('archived') || s.includes('retired')) return 'past';
  if (s.startsWith('parked')) return 'parked';
  return null;
}

const raw = await getCollection('notes');
const items = raw
  .filter((n) => {
    const kind = archiveKind(n.data.status);
    if (!kind) return false;
    if (n.data.draft) return false;
    return n.id.startsWith('projects/') && n.id !== 'projects/index' && n.data.type === 'project';
  })
  .map((n) => {
    const fm = n.data as Record<string, unknown>;
    const cardHref = typeof fm.cardHref === 'string' && fm.cardHref ? fm.cardHref : '';
    return {
      title: deriveTitle(n.data, n.id, n.body),
      blurb: String(fm.blurb ?? fm.description ?? ''),
      kind: archiveKind(n.data.status)!,
      href: cardHref || slugToUrl(n.id),
      source: deriveSourceLine(n.id),
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const past = items.filter((i) => i.kind === 'past');
const parked = items.filter((i) => i.kind === 'parked');
---

<Base title="Archive" description="Archived and parked projects." active="projects">
  <main class="archive-page">
    <div class="wrap">
      <header class="head">
        <p class="trail"><a href="/projects/">Projects</a></p>
        <h1>Archive</h1>
        <p class="head__lede">
          Parked and finished projects stay published here. Active work stays on <a href="/projects/">Projects</a>.
        </p>
      </header>
      {
        past.length > 0 && (
          <section>
            <h2>Archived projects</h2>
            <ul>
              {past.map((p) => (
                <li>
                  <a href={p.href}>{p.title}</a>
                  {(p.blurb || p.source) && <span>{p.blurb || p.source}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        parked.length > 0 && (
          <section>
            <h2>Parked</h2>
            <ul>
              {parked.map((p) => (
                <li>
                  <a href={p.href}>{p.title}</a>
                  {(p.blurb || p.source) && <span>{p.blurb || p.source}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 34px 28px 52px;
  }
  .trail {
    font-family: var(--mono);
    font-size: var(--kb-text-xs);
    margin: 0 0 10px;
  }
  .trail a {
    color: var(--mut);
    text-decoration: none;
  }
  .trail a:hover {
    color: var(--accent);
  }
  .head h1 {
    font-family: var(--ming);
    font-size: var(--kb-text-h1-shell);
    font-weight: 500;
    color: var(--ink);
    margin: 0;
  }
  .head__lede {
    color: var(--mut);
    max-width: 62ch;
  }
  .head__lede a {
    color: var(--accent);
  }
  h2 {
    font-family: var(--ming);
    font-size: 1.15rem;
    color: var(--ink);
    margin: 1.6rem 0 0.4rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
  li a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
  }
  li a:hover {
    color: var(--accent);
  }
  li span {
    display: block;
    color: var(--mut);
    font-size: 0.92rem;
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
  }
</style>
