---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deriveSourceLine, deriveTitle } from '../lib/note';
import { slugToUrl } from '../lib/slug';

type ArchiveKind = 'past' | 'parked';

function archiveKind(status: unknown): ArchiveKind | null {
  const s = String(status ?? '').toLowerCase();
  if (s.startsWith('past') || s.includes('archived') || s.includes('retired')) return 'past';
  if (s.startsWith('parked')) return 'parked';
  return null;
}

const raw = await getCollection('notes');
const items = raw
  .filter((n) => {
    const kind = archiveKind(n.data.status);
    if (!kind) return false;
    if (n.data.draft) return false;
    return n.id.startsWith('projects/') && n.id !== 'projects/index' && n.data.type === 'project';
  })
  .map((n) => {
    const fm = n.data as Record<string, unknown>;
    const cardHref = typeof fm.cardHref === 'string' && fm.cardHref ? fm.cardHref : '';
    return {
      slug: n.id,
      title: deriveTitle(n.data, n.id, n.body),
      blurb: String(fm.blurb ?? fm.description ?? ''),
      kind: archiveKind(n.data.status)!,
      href: cardHref || slugToUrl(n.id),
      source: deriveSourceLine(n.id),
    };
  })
  .sort((a, b) => a.title.localeCompare(b.title));

const past = items.filter((i) => i.kind === 'past');
const parked = items.filter((i) => i.kind === 'parked');
---

<Base title="Archive" description="Archived and parked projects." active="">
  <main class="archive-page">
    <div class="wrap">
      <header class="head">
        <h1>Archive</h1>
        <p class="head__lede">
          Parked and finished projects stay published here. Active work stays on
          <a href="/projects/">Projects</a>.
        </p>
      </header>

      {
        past.length > 0 && (
          <section class="group">
            <h2>Archived projects</h2>
            <ul class="list">
              {past.map((p) => (
                <li class="list__item">
                  <a href={p.href} class="list__link">
                    <span class="list__title">{p.title}</span>
                    {p.blurb && <span class="list__blurb">{p.blurb}</span>}
                    <span class="list__source">{p.source}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        parked.length > 0 && (
          <section class="group">
            <h2>Parked</h2>
            <ul class="list">
              {parked.map((p) => (
                <li class="list__item">
                  <a href={p.href} class="list__link">
                    <span class="list__title">{p.title}</span>
                    {p.blurb && <span class="list__blurb">{p.blurb}</span>}
                    <span class="list__source">{p.source}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {items.length === 0 && <p class="empty">Nothing archived yet.</p>}
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: 42rem;
    margin: 0 auto;
    padding: 48px 28px 64px;
  }
  .head h1 {
    font-family: var(--ming);
    font-size: var(--kb-text-h1-shell);
    font-weight: 500;
    margin: 0;
    color: var(--ink);
  }
  .head__lede {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    line-height: var(--kb-lh-body);
    color: var(--mut);
    margin: 12px 0 0;
    max-width: 40rem;
  }
  .head__lede a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 60%, transparent);
  }
  .group {
    margin-top: 36px;
  }
  .group h2 {
    font-family: var(--ming);
    font-size: var(--kb-text-h2-shell);
    font-weight: 600;
    margin: 0 0 12px;
    color: var(--ink);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list__item {
    border-top: 1px solid var(--rule);
  }
  .list__item:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .list__link {
    display: grid;
    gap: 4px;
    padding: 14px 0;
    text-decoration: none;
    color: inherit;
  }
  .list__link:hover .list__title {
    color: var(--accent);
  }
  .list__title {
    font-family: var(--ming);
    font-size: var(--kb-text-md);
    font-weight: 600;
    color: var(--ink);
  }
  .list__blurb {
    font-family: var(--ming);
    font-size: var(--kb-text-base);
    line-height: var(--kb-lh-body);
    color: var(--mut);
  }
  .list__source {
    font-family: var(--sans);
    font-size: var(--kb-text-sm);
    color: var(--faint);
  }
  .empty {
    margin-top: 24px;
    font-size: var(--kb-text-base);
    color: var(--faint);
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 36px 16px 48px;
    }
  }
</style>