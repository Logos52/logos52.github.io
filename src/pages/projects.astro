---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deriveTitle } from '../lib/note';
import { slugToUrl } from '../lib/slug';

type Status = 'current' | 'past';

// Owner-set priority order (most important first); the rest fall back to frontmatter `order`.
const PRIORITY = ['projects/tsumugu-ed', 'projects/llm-knowledge-base', 'projects/wnac'];
const rank = (slug: string) => {
  const i = PRIORITY.indexOf(slug);
  return i === -1 ? 99 : i;
};

const raw = (await getCollection('notes')).filter(
  (n) => n.id.startsWith('projects/') && n.id !== 'projects/index' && n.data.type === 'project',
);

const projects = raw
  .map((n) => {
    const fm = n.data as Record<string, unknown>;
    const rawStatus = String(fm.status ?? 'current').toLowerCase();
    const status: Status =
      rawStatus.startsWith('current') || rawStatus.startsWith('active') ? 'current' : 'past';
    const stack = Array.isArray(fm.stack) ? fm.stack.map(String) : fm.stack ? [String(fm.stack)] : [];
    const order = typeof fm.order === 'number' ? fm.order : 99;
    const image = typeof fm.image === 'string' ? fm.image : '';
    // A project may override its card link (e.g. point at a standalone HTML page in public/) via
    // frontmatter `cardHref`; otherwise the card opens the note page.
    const cardHref = typeof fm.cardHref === 'string' && fm.cardHref ? fm.cardHref : '';
    return {
      slug: n.id,
      title: deriveTitle(n.data, n.id, n.body),
      blurb: String(fm.blurb ?? fm.description ?? ''),
      status,
      stack,
      order,
      image,
      href: cardHref || slugToUrl(n.id),
    };
  })
  .sort((a, b) => rank(a.slug) - rank(b.slug) || a.order - b.order || a.title.localeCompare(b.title));

const groups: { key: Status; label: string }[] = [
  { key: 'current', label: 'Current' },
  { key: 'past', label: 'Archived' },
];

const ARCHIVE_HREF = '/archive/';

/** Vary image height per card (NDC Whiteboard index rhythm). */
function imageHeight(slug: string): number {
  let h = 0;
  for (let i = 0; i < slug.length; i++) h = (h + slug.charCodeAt(i) * (i + 3)) % 997;
  return 120 + (h % 100);
}

---

<Base title="Projects" description="Learning-system, agentic-engineering, and personal-tooling projects." active="projects">
  <main class="projects-page">
    <div class="wrap">
      <div class="projects-main">
        <header class="head">
          <h1>Projects</h1>
          <p class="head__lede">Learning-system, agentic-engineering, and personal-tooling projects.</p>
        </header>
        {groups.map((g) => {
          const items = projects.filter((p) => p.status === g.key);
          if (!items.length) return null;
          return (
            <section class="group">
              <h2>
                {g.label}
                {g.key === 'past' && (
                  <a class="group__more" href={ARCHIVE_HREF}>Full archive</a>
                )}
              </h2>
              <div class="whiteboard">
                {items.map((p) => (
                  <a class="card" href={p.href}>
                    {p.image && (
                      <div class="card__media">
                        <img
                          src={`/${p.image}`}
                          alt={`${p.title} screenshot`}
                          loading="lazy"
                          style={`height:${imageHeight(p.slug)}px`}
                        />
                      </div>
                    )}
                    <h3>{p.title}</h3>
                    <p>{p.blurb}</p>
                    {p.stack.length > 0 && (
                      <div class="stack">
                        {p.stack.map((s) => (
                          <span class="tag">{s}</span>
                        ))}
                      </div>
                    )}
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </main>
</Base>

<style>
  .wrap {
    max-width: var(--kb-content);
    margin: 0 auto;
    padding: 34px 28px 52px;
  }
  .projects-main {
    min-width: 0;
  }
  .head {
    padding: 0 0 12px;
  }
  .head h1 {
    font-family: var(--ming);
    font-size: var(--kb-text-h1-shell);
    font-weight: 500;
    margin: 0;
  }
  .head p {
    margin: 10px 0 0;
    color: var(--mut);
    font-size: var(--kb-text-base);
    max-width: 40rem;
  }
  .group {
    margin: 36px 0 0;
  }
  .group h2 {
    font-family: var(--ming);
    font-size: var(--kb-text-h2-shell);
    font-weight: 600;
    margin: 0 0 20px;
    color: var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }
  .group__more {
    font-family: var(--sans);
    font-size: var(--kb-text-sm);
    font-weight: 400;
    color: var(--mut);
    text-decoration: none;
  }
  .group__more:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .whiteboard {
    column-count: 3;
    column-gap: 32px;
  }
  .card {
    display: block;
    break-inside: avoid;
    margin: 0 0 32px;
    text-decoration: none;
    color: inherit;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .card__media {
    margin: 0 0 12px;
    overflow: hidden;
  }
  .card__media img {
    width: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .card h3 {
    margin: 0 0 6px;
    font-family: var(--ming);
    font-size: var(--kb-text-md);
    font-weight: 600;
    color: var(--ink);
  }
  .card p {
    margin: 0;
    font-size: var(--kb-text-sm);
    line-height: var(--kb-lh-body);
    color: var(--mut);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
    padding-top: 6px;
  }
  .tag {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--faint);
    border: 1px solid var(--rule2);
    border-radius: 4px;
    padding: 1px 5px;
  }
  @media (max-width: 900px) {
    .whiteboard {
      column-count: 2;
    }
  }
  @media (max-width: 640px) {
    .wrap {
      padding: 28px 16px 40px;
    }
    .whiteboard {
      column-count: 1;
    }
  }
</style>