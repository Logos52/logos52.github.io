---
import { readFileSync } from 'node:fs';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { deriveTitle } from '../lib/note';
import { slugToUrl } from '../lib/slug';

const views = readFileSync('src/data/projects-views.html', 'utf8');
const notes = await getCollection('notes');
const projects = notes.filter((n) => n.id.startsWith('projects/') && n.id !== 'projects/index' && n.data.type === 'project' && n.id !== 'projects/tsumugu');

type Card = { slug: string; title: string; blurb: string; href: string; status: string };
const cards: Card[] = projects.map((n) => {
  const fm = n.data as Record<string, unknown>;
  const raw = String(fm.status ?? 'current').toLowerCase();
  const status = raw.startsWith('current') || raw.startsWith('active') ? 'current' : 'past';
  const cardHref = typeof fm.cardHref === 'string' ? fm.cardHref : '';
  return {
    slug: n.id,
    title: deriveTitle(n.data, n.id, n.body),
    blurb: String(fm.blurb ?? fm.description ?? ''),
    href: cardHref || slugToUrl(n.id),
    status,
  };
});
const onBoard = new Set(['projects/tsumugu-ed', 'projects/llm-knowledge-base', 'projects/builders-logs-2026', 'projects/wnac']);
const extraCurrent = cards.filter((c) => c.status === 'current' && !onBoard.has(c.slug));
const archived = cards.filter((c) => c.status !== 'current');
---

<Base title="Projects — Logos52" description="Learning-system, agentic-engineering, and personal-tooling projects." section="projects">
  <div class="page" id="page-projects" data-views set:html={views} />
  {
    (extraCurrent.length > 0 || archived.length > 0) && (
      <div class="page archived">
        {
          extraCurrent.length > 0 && (
            <section>
              <h2 class="sec-h">Current</h2>
              {extraCurrent.map((p) => (
                <a class="rw" href={p.href}>
                  <b>{p.title}</b>
                  {p.blurb && <span>{p.blurb}</span>}
                </a>
              ))}
            </section>
          )
        }
        {
          archived.length > 0 && (
            <section>
              <h2 class="sec-h">Archived</h2>
              {archived.map((p) => (
                <a class="rw" href={p.href}>
                  <b>{p.title}</b>
                  {p.blurb && <span>{p.blurb}</span>}
                </a>
              ))}
            </section>
          )
        }
      </div>
    )
  }
</Base>
