# Quartz caches (engine removed; public/ is now Astro's TRACKED static dir)
.quartz-cache/
.aider*

# 01 - Workbench/ directory is public; files inside are private working drafts
01 - Workbench/*

# Local convenience symlink into tsumugu/personal/ — never publish (leaks path + can break the remote build)
Tsumugu Clips
