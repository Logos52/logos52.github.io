{
  "profile": "adopt",
  "languages": ["ts", "mjs", "astro", "py", "css"],
  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "coverage/**",
    ".astro/**",
    "src/content/notes/**",
    "scripts/build-builders-logs-wiki.mjs",
    "scripts/build-digital-gardeners-data.mjs",
    "scripts/execute-wiki-cut-ai-door.mjs",
    "scripts/truncate-ai-door-folds.mjs",
    "**/*.sh",
    "**/*.js",
    "**/*.cjs",
    "**/*.tsx",
    "**/*.scss"
  ],
  "proseGlobs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**/*.md",
    "**/docs/**/*.md"
  ],
  "boundaryFiles": ["src/lib/domain.ts", "src/lib/map-rows.ts"],
  "baseline": ".lint-kit-baseline.json",
  "batch": "v4",
  "rules": {
    "R3": "error"
  },
  "prose": {
    "allow": []
  }
}
