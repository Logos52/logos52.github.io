{
  "profile": "adopt",
  "languages": [
    "ts",
    "mjs",
    "astro",
    "py",
    "css"
  ],
  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "coverage/**",
    ".astro/**",
    "src/content/notes/**",
    "src/styles/site.css",
    "design-archive/**",
    "design/ndc-export/**",
    "scripts/build-builders-logs-wiki.mjs",
    "scripts/build-digital-gardeners-data.mjs",
    "scripts/execute-wiki-cut-ai-door.mjs",
    "scripts/truncate-ai-door-folds.mjs",
    "**/*.sh",
    "**/*.js",
    "**/*.cjs",
    "**/*.tsx",
    "**/*.scss"
  ],
  "proseGlobs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**/*.md",
    "**/docs/**/*.md"
  ],
  "boundaryFiles": [
    "src/lib/domain.ts"
  ],
  "baseline": ".lint-kit-baseline.json",
  "batch": "v4",
  "rules": {
    "R3": "error"
  },
  "prose": {
    "allow": []
  }
}
