{
  "profile": "adopt",
  "languages": ["ts", "mjs", "astro", "py", "css"],
  "ignore": [
    "node_modules/**",
    "dist/**",
    ".git/**",
    "coverage/**",
    ".astro/**",
    "src/content/notes/**",
    "**/*.sh",
    "**/*.js",
    "**/*.cjs",
    "**/*.tsx",
    "**/*.scss"
  ],
  "proseGlobs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/**/*.md",
    "**/docs/**/*.md"
  ],
  "boundaryFiles": [],
  "baseline": ".lint-kit-baseline.json",
  "batch": "v4",
  "rules": {
    "R3": "error"
  },
  "prose": {
    "allow": []
  }
}
