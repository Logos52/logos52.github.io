filters:
  and:
    - file.inFolder("pans-mg-kolbs-template/Kolbs")
    - file.hasProperty("status")
properties:
  file.name:
    displayName: Session
  note.marginal-gains:
    displayName: Marginal gains
  note.experiments:
    displayName: Experiments
views:
  - type: table
    name: Kolbs
    order:
      - file.name
      - marginal-gains
      - experiments
    sort:
      - property: file.mtime
        direction: DESC
