filters:
  and:
    - file.inFolder("pans-mg-kolbs-template/Goals")
    - file.hasProperty("status")
properties:
  file.name:
    displayName: Goal
views:
  - type: table
    name: Active
    filters:
      and:
        - status != "Archived"
    order:
      - file.name
      - status
      - start-date
      - end-date
