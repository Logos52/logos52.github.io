filters:
  and:
    - file.inFolder("mg-kolbs/Skills")
    - file.hasProperty("competency")
formulas:
  competency_display: if(competency.startsWith("CI"), "CI", competency)
  progress: html("<span class='cc-bar'><i style='width:" + (note["current-level"] / note["final-level"] * 100).round() + "%'></i></span>")
properties:
  file.name:
    displayName: Skill
  formula.competency_display:
    displayName: Competency
  formula.progress:
    displayName: Progress
views:
  - type: table
    name: Skills
    order:
      - file.name
      - formula.competency_display
      - formula.progress
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      formula.progress: 150
  - type: table
    name: All
    order:
      - file.name
      - current-level
      - final-level
      - formula.competency_display
